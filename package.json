{
  "name": "playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://playground.humza-butt.space",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "analyze": "npm run build && node scripts/analyze-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "spec:new": "node scripts/spec-new.mjs",
    "spec:check": "node scripts/spec-check.mjs",
    "deploy:preview": "npm run build && wrangler pages deploy --branch=preview",
    "deploy:prod": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "chrome-launcher": "^1.2.1",
    "jsdom": "^28.1.0",
    "lighthouse": "^12.8.2",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}
