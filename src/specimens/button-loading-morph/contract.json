{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/button-loading-morph.schema.json",
  "title": "ButtonLoadingMorph",
  "description": "Portable contract for button loading morph sequence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "button", "sequence", "reducedMotion", "a11y", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "button-loading-morph" },
    "intent": {
      "type": "string",
      "const": "Label becomes finite progress state inside same button boundary."
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx"],
      "properties": {
        "widthPx": { "type": "number", "const": 160 },
        "heightPx": { "type": "number", "const": 48 }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labelFadeMs", "loadMs", "checkMorphMs", "savedDwellMs"],
      "properties": {
        "labelFadeMs": { "type": "number", "const": 80 },
        "loadMs": { "type": "number", "const": 900 },
        "checkMorphMs": { "type": "number", "const": 180 },
        "savedDwellMs": { "type": "number", "const": 1200 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["determinateFill", "triggers"],
      "properties": {
        "determinateFill": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"]
        }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["politeStatus", "disabledWhileBusy"],
      "properties": {
        "politeStatus": { "type": "boolean", "const": true },
        "disabledWhileBusy": { "type": "boolean", "const": true }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "btn", "label", "loader"],
      "properties": {
        "root": { "type": "string", "const": "blm" },
        "btn": { "type": "string", "const": "blm__btn" },
        "label": { "type": "string", "const": "blm__label" },
        "loader": { "type": "string", "const": "blm__loader" }
      }
    }
  }
}
