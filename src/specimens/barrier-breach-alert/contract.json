{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/barrier-breach-alert.schema.json",
  "title": "BarrierBreachAlert",
  "description": "An intact perimeter fractures at one fixed point, flashing the field and edge red with a bounded alarm pulse.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "alarmMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "barrier-breach-alert" },
    "alarmMs": { "type": "number", "const": 700 },
    "settleMs": { "type": "number", "const": 60 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alert", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "alert": { "type": "string", "const": "#D94A38" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateBreached"],
      "properties": {
        "immediateBreached": { "type": "boolean", "const": true }
      }
    }
  }
}
