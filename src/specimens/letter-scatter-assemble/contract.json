{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/letter-scatter-assemble.schema.json",
  "title": "LetterScatterAssemble",
  "description": "Portable contract for a kinetic letter-scatter headline assemble. Not a database schema. No copyrighted assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "colours",
    "typography",
    "letters",
    "animation",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "letter-scatter-assemble"
    },
    "intent": {
      "type": "string",
      "const": "Scattered letters assemble into a two-line NEW MATERIAL / AVAILABLE headline with overshoot, collision shards, and finale recoil."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line1", "line2", "trigger", "srOnlyLabel"],
      "properties": {
        "line1": { "type": "string", "const": "NEW MATERIAL" },
        "line2": { "type": "string", "const": "AVAILABLE" },
        "trigger": { "type": "string", "const": "ASSEMBLE" },
        "srOnlyLabel": {
          "type": "string",
          "const": "New material available"
        }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "red", "paper"],
      "properties": {
        "ink": { "type": "string", "const": "#090909" },
        "red": { "type": "string", "const": "#e60012" },
        "paper": { "type": "string", "const": "#f5f1e8" }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontFamily", "layout"],
      "properties": {
        "fontFamily": {
          "type": "string",
          "const": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
        },
        "layout": {
          "type": "string",
          "const": "flex lines establish final positions; transforms only for scatter"
        }
      }
    },
    "letters": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "description": "Frozen initial transforms — no runtime randomness.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "glyph",
          "word",
          "translateXPx",
          "translateYPx",
          "rotateDeg",
          "scale",
          "overshootXPx",
          "overshootYPx",
          "overshootRotateDeg",
          "delayMs",
          "durationMs"
        ]
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "availableWordOffsetMs",
        "shardAtMs",
        "shardDurationMs",
        "finaleLandMs",
        "recoilMs",
        "recoilTranslateXPx"
      ],
      "properties": {
        "name": { "type": "string", "const": "lsa-assemble" },
        "availableWordOffsetMs": { "type": "number", "const": 180 },
        "shardAtMs": { "type": "number", "const": 520 },
        "shardDurationMs": { "type": "number", "const": 120 },
        "shardCount": { "type": "integer", "const": 4 },
        "finaleLandMs": { "type": "number", "const": 976 },
        "recoilMs": { "type": "number", "const": 90 },
        "recoilTranslateXPx": { "type": "number", "const": 2 }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "singlePhraseAnnouncement",
        "lettersDecorative",
        "doNotReadEachLetter"
      ],
      "properties": {
        "singlePhraseAnnouncement": { "type": "boolean", "const": true },
        "lettersDecorative": { "type": "boolean", "const": true },
        "doNotReadEachLetter": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["showFinalHeadlineImmediately", "triggers"],
      "properties": {
        "showFinalHeadlineImmediately": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "prefers-reduced-motion: reduce",
              "data-force-reduced-motion=true"
            ]
          }
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "letter", "trigger", "status"],
      "properties": {
        "root": { "type": "string", "const": "lsa" },
        "letter": { "type": "string", "const": "lsa__letter" },
        "trigger": { "type": "string", "const": "lsa__trigger" },
        "status": { "type": "string", "const": "lsa__status" },
        "stateAssemble": { "type": "string", "const": "lsa--assemble" },
        "stateSettled": { "type": "string", "const": "lsa--settled" },
        "stateReduced": { "type": "string", "const": "lsa--reduced" }
      }
    }
  },
