{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fog-forecast-warning",
  "description": "Upcoming fog/deadline creates a prominent forecast alert.",
  "type": "object",
  "required": [
    "name",
    "intent",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "fog-forecast-warning"
    },
    "intent": {
      "type": "string",
      "const": "Upcoming fog/deadline creates a prominent forecast alert."
    },
    "colours": {
      "type": "object",
      "properties": {
        "yellow": {
          "const": "#F5C400"
        },
        "ink": {
          "const": "#101010"
        },
        "paper": {
          "const": "#F7F3E8"
        },
        "gray": {
          "const": "#E8E8E8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "properties": {
        "triggers": {
          "type": "array",
          "items": {
            "enum": [
              "prefers-reduced-motion: reduce",
              "data-force-reduced-motion=true"
            ]
          }
        }
      }
    }
  }
}