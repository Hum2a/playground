{
  "name": "comic-panel-wipe",
  "intent": "Five irregular clipped panels slam across the viewport, cover content for a swap window, then tear away in non-mirrored exit directions.",
  "colours": {
    "red": "#e60012",
    "black": "#090909",
    "paper": "#f5f1e8"
  },
  "panels": [
    {
      "id": 1,
      "className": "comic-wipe__panel--1",
      "colour": "#090909",
      "enterFrom": "left",
      "exitTo": "up",
      "delayMs": 0,
      "clipPath": "polygon(0% 0%, 78% 0%, 100% 18%, 82% 34%, 96% 52%, 74% 68%, 92% 86%, 70% 100%, 0% 100%)"
    },
    {
      "id": 2,
      "className": "comic-wipe__panel--2",
      "colour": "#e60012",
      "enterFrom": "top-right",
      "exitTo": "left",
      "delayMs": 45,
      "clipPath": "polygon(18% 0%, 100% 0%, 100% 100%, 0% 100%, 8% 62%, 28% 28%)"
    },
    {
      "id": 3,
      "className": "comic-wipe__panel--3",
      "colour": "#f5f1e8",
      "enterFrom": "bottom-left",
      "exitTo": "right",
      "delayMs": 90,
      "clipPath": "polygon(0% 22%, 62% 0%, 100% 38%, 48% 100%, 0% 100%)"
    },
    {
      "id": 4,
      "className": "comic-wipe__panel--4",
      "colour": "#090909",
      "enterFrom": "bottom-right",
      "exitTo": "down",
      "delayMs": 135,
      "clipPath": "polygon(12% 0%, 100% 8%, 100% 100%, 0% 100%, 0% 34%, 22% 18%)",
      "content": "microtype"
    },
    {
      "id": 5,
      "className": "comic-wipe__panel--5",
      "colour": "#e60012",
      "enterFrom": "left-upper",
      "exitTo": "upper-right",
      "delayMs": 180,
      "clipPath": "polygon(0% 0%, 88% 0%, 100% 22%, 92% 48%, 100% 72%, 78% 100%, 0% 100%, 8% 56%)",
      "content": "impact"
    }
  ],
  "timing": {
    "easing": "cubic-bezier(0.7, 0, 0.3, 1)",
    "totalMs": 1050,
    "attackMs": 380,
    "coveredStartMs": 380,
    "coveredEndMs": 520,
    "onCoveredMs": 450,
    "tearAwayStartMs": 520,
    "staggerMs": [0, 45, 90, 135, 180]
  },
  "typography": {
    "fontFamily": "ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif",
    "microtype": "NEXT → NEXT → 次へ → NEXT → NEXT → 次へ → NEXT → NEXT → 次へ →",
    "impact": "NEXT!"
  },
  "api": {
    "export": "runComicWipe(onCovered)",
    "busyGuard": true,
    "swapOnlyInsideOnCovered": true,
    "sandboxSafe": true
  },
  "a11y": {
    "overlayAriaHidden": true,
    "idlePointerEvents": "none",
    "doNotFocusOverlay": true,
    "focusAfterSwap": "newly revealed peer button"
  },
  "reducedMotion": {
    "triggers": [
      "@media (prefers-reduced-motion: reduce)",
      "[data-force-reduced-motion=\"true\"]"
    ],
    "behaviour": "Skip sweeping sequence; brief static cover flash then onCovered and reveal"
  },
  "constraints": {
    "flatFillsOnly": true,
    "noGradients": true,
    "noBlur": true,
    "noGlass": true,
    "noSoftShadows": true,
    "noRoundedPanels": true,
    "no3d": true,
    "noFontFace": true,
    "nonMirroredExits": true
  }
}
