{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/stage-manager-stack-shift.schema.json",
  "title": "StageManagerStackShift",
  "description": "Portable contract for Stage Manager–inspired foreground/staged workspace swap.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "layout",
    "swap",
    "animation",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "stage-manager-stack-shift" },
    "intent": {
      "type": "string",
      "const": "Foreground BUILD (two windows) swaps with staged RESEARCH (three mini silhouettes); z-order transfers at 52%; one stage marker moves active state."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground", "staged", "trigger"],
      "properties": {
        "foreground": { "type": "string", "const": "BUILD" },
        "staged": { "type": "string", "const": "RESEARCH" },
        "trigger": { "type": "string", "const": "SWAP" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foregroundWidthPx", "foregroundHeightPx", "railWidthPx", "buildWindows", "researchWindows"],
      "properties": {
        "foregroundWidthPx": { "type": "number", "const": 360 },
        "foregroundHeightPx": { "type": "number", "const": 330 },
        "railWidthPx": { "type": "number", "const": 92 },
        "buildWindows": { "type": "number", "const": 2 },
        "researchWindows": { "type": "number", "const": 3 }
      }
    },
    "swap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildScale", "researchScale", "buildTranslateXPx", "researchTranslateXPx", "zSwapAt"],
      "properties": {
        "buildScale": { "type": "array", "const": [1, 0.72] },
        "researchScale": { "type": "array", "const": [0.72, 1] },
        "buildTranslateXPx": { "type": "array", "const": [0, -190] },
        "researchTranslateXPx": { "type": "array", "const": [190, 0] },
        "zSwapAt": { "type": "number", "const": 0.52 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs", "bothVisibleDuringSwap"],
      "properties": {
        "durationMs": { "type": "number", "const": 480 },
        "bothVisibleDuringSwap": { "type": "boolean", "const": true }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["politeStatus", "stageMarker"],
      "properties": {
        "politeStatus": { "type": "boolean", "const": true },
        "stageMarker": { "type": "number", "const": 1 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantSwap", "triggers"],
      "properties": {
        "instantSwap": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": [
            "prefers-reduced-motion: reduce",
            "data-force-reduced-motion=true"
          ]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "rail", "workspace", "group"],
      "properties": {
        "root": { "type": "string", "const": "sms" },
        "rail": { "type": "string", "const": "sms__rail" },
        "workspace": { "type": "string", "const": "sms__workspace" },
        "group": { "type": "string", "const": "sms__group" }
      }
    }
  }
}
