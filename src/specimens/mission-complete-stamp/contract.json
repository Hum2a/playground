{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/mission-complete-stamp.schema.json",
  "title": "MissionCompleteStamp",
  "description": "A briefing card receives a large original completion seal that slams down and rings out into COMPLETE.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slamMs", "ringMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "mission-complete-stamp" },
    "slamMs": { "type": "number", "const": 220 },
    "ringMs": { "type": "number", "const": 260 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alarm", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "alarm": { "type": "string", "const": "#D94A38" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateComplete"],
      "properties": {
        "immediateComplete": { "type": "boolean", "const": true }
      }
    }
  }
}
