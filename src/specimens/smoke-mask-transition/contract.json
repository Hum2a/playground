{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/smoke-mask-transition.schema.json",
  "title": "SmokeMaskTransition",
  "description": "Overlapping circles cover the stage, a content swap happens under cover, then the circles disperse to reveal the new state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "circleCount", "coverAtMs", "totalMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "smoke-mask-transition" },
    "circleCount": { "type": "number", "const": 6 },
    "coverAtMs": { "type": "number", "const": 300 },
    "totalMs": { "type": "number", "const": 700 },
    "settleMs": { "type": "number", "const": 140 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateSwap"],
      "properties": {
        "immediateSwap": { "type": "boolean", "const": true }
      }
    }
  }
}
