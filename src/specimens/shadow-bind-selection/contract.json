{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/shadow-bind-selection.schema.json",
  "title": "ShadowBindSelection",
  "description": "A shadow tendril extends from a source anchor to a target card and locks both as one bound selection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "extendMs", "lockMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "shadow-bind-selection" },
    "extendMs": { "type": "number", "const": 260 },
    "lockMs": { "type": "number", "const": 220 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alarm", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "alarm": { "type": "string", "const": "#D94A38" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateBound"],
      "properties": {
        "immediateBound": { "type": "boolean", "const": true }
      }
    }
  }
}
