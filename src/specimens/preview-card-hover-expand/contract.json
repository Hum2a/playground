{
  "name": "preview-card-hover-expand",
  "intent": "Hovering or focusing a content card previews it in place while its neighbour(s) translate outward to make room, without overlap.",
  "primitives": ["preview", "hover", "expand"],
  "colours": {
    "ink": "#0c0c0f",
    "panel": "#16161d",
    "panel2": "#1e1e26",
    "rule": "#2a2a34",
    "pewter": "#8a8e9b",
    "chalk": "#eceef2",
    "amber": "#e8a45a",
    "teal": "#4ecdc4"
  },
  "cards": {
    "count": 3,
    "width": 118,
    "height": 168,
    "titles": ["SIGNAL DRIFT", "AMBER FIELD", "NIGHT ROUTE"]
  },
  "states": {
    "expandScale": 1.18,
    "neighbourPushPx": 18,
    "neighbourScaleUnchanged": true
  },
  "timing": {
    "transitionMs": 220,
    "easing": "cubic-bezier(.4,0,.2,1)"
  },
  "triggers": {
    "expand": ["mouseenter", "focus"],
    "collapse": ["mouseleave row", "focusout past row"]
  },
  "a11y": {
    "cardElement": "button",
    "ariaExpanded": true,
    "liveHint": "polite text naming previewed title"
  },
  "reducedMotion": {
    "triggers": [
      "@media (prefers-reduced-motion: reduce)",
      "[data-force-reduced-motion=\"true\"]"
    ],
    "behaviour": "Expand/push states still apply instantly with no transition"
  }
}
