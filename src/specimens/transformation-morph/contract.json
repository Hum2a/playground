{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/transformation-morph.schema.json",
  "title": "TransformationMorph",
  "description": "Profile A collapses through a bold silhouette intermediate and expands into profile B.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "collapseMs", "holdMs", "revealMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "transformation-morph" },
    "collapseMs": { "type": "number", "const": 140 },
    "holdMs": { "type": "number", "const": 90 },
    "revealMs": { "type": "number", "const": 150 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateProfileB"],
      "properties": {
        "immediateProfileB": { "type": "boolean", "const": true }
      }
    }
  }
}
