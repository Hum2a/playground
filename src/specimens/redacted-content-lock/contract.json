{
  "name": "redacted-content-lock",
  "intent": "Locked lesson card where five irregular black redaction bars censor specific copy regions, then a diagonal RESTRICTED stamp settles. Unlock retracts censorship without fading host content.",
  "colours": {
    "black": "#090909",
    "red": "#e60012",
    "paper": "#f5f1e8"
  },
  "copy": {
    "title": "ADVANCED TYPESCRIPT",
    "description": "Learn conditional types, mapped types and infer patterns.",
    "metaLabel": "LESSON",
    "metaValue": "12",
    "action": "OPEN LESSON",
    "stamp": "RESTRICTED",
    "srLocked": "Advanced Typescript. Restricted content.",
    "srUnlocked": "Advanced Typescript lesson available."
  },
  "bars": [
    {
      "id": 1,
      "target": "title",
      "direction": "left",
      "rotateDeg": -1.2,
      "heightPx": 22,
      "delayMs": 0,
      "overshootPx": 6,
      "clipPath": "polygon(0% 18%, 4% 0%, 97% 8%, 100% 72%, 96% 100%, 2% 92%)"
    },
    {
      "id": 2,
      "target": "description-a",
      "direction": "right",
      "rotateDeg": 1.5,
      "heightPx": 18,
      "delayMs": 65,
      "overshootPx": 6,
      "clipPath": "polygon(0% 28%, 6% 0%, 100% 12%, 98% 88%, 94% 100%, 1% 78%)"
    },
    {
      "id": 3,
      "target": "description-b",
      "direction": "left",
      "rotateDeg": -0.8,
      "heightPx": 20,
      "delayMs": 120,
      "overshootPx": 6,
      "clipPath": "polygon(1% 8%, 8% 0%, 99% 18%, 100% 82%, 93% 100%, 0% 90%)"
    },
    {
      "id": 4,
      "target": "meta-value",
      "direction": "top-right",
      "rotateDeg": 2,
      "heightPx": 16,
      "delayMs": 180,
      "overshootPx": 5,
      "clipPath": "polygon(0% 22%, 12% 0%, 100% 10%, 96% 100%, 8% 90%)"
    },
    {
      "id": 5,
      "target": "action",
      "direction": "right",
      "rotateDeg": -1.5,
      "heightPx": 26,
      "delayMs": 240,
      "overshootPx": 6,
      "clipPath": "polygon(0% 16%, 5% 0%, 100% 22%, 98% 100%, 3% 86%)"
    }
  ],
  "stamp": {
    "label": "RESTRICTED",
    "rotateDeg": -5,
    "offsetXPx": 5,
    "offsetYPx": 6,
    "delayMs": 340,
    "durationMs": 180
  },
  "timing": {
    "lockTotalMs": 520,
    "unlockTotalMs": 360,
    "barTravelMs": 100,
    "barDelaysMs": [0, 65, 120, 180, 240],
    "unlockStampMs": 80,
    "unlockBarStartsMs": [70, 110, 150, 190, 230],
    "loops": false
  },
  "a11y": {
    "barsDecorative": true,
    "stampDecorative": true,
    "srLockedLabel": "Advanced Typescript. Restricted content.",
    "hideContentFromAtWhenLocked": true,
    "disableActionWhileLocked": true,
    "productionMustGateContentAccess": true
  },
  "reducedMotion": {
    "immediateStateSwitch": true,
    "triggers": [
      "prefers-reduced-motion: reduce",
      "data-force-reduced-motion=true"
    ]
  },
  "constraints": {
    "noFullCardRectangle": true,
    "noHostContentFade": true,
    "noLoopInSettledState": true,
    "noExternalAssets": true,
    "noFontFace": true,
    "noNetwork": true,
    "barsOnLocalWrappers": true
  },
  "classNames": {
    "root": "rcl",
    "card": "rcl__card",
    "content": "rcl__content",
    "censor": "rcl__censor",
    "bar": "rcl__bar",
    "stamp": "rcl__stamp",
    "action": "rcl__action"
  }
}
