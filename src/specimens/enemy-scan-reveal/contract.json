{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/enemy-scan-reveal.schema.json",
  "title": "EnemyScanReveal",
  "description": "Vertical L→R scanner reveals unknown entity fields at frozen x-thresholds; incomplete outline completes; trailing 40px grid. Analysis primitive. Original CSS only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "colours",
    "thresholds",
    "animation",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "enemy-scan-reveal" },
    "intent": {
      "type": "string",
      "const": "A target begins with unknown metadata; a vertical scanner travels left to right and reveals each property when it crosses a fixed x-threshold."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "analyse",
        "complete",
        "status",
        "fields"
      ],
      "properties": {
        "entity": { "type": "string", "const": "ENTITY // 07" },
        "analyse": { "type": "string", "const": "ANALYSE" },
        "complete": { "type": "string", "const": "ANALYSIS COMPLETE" },
        "status": {
          "type": "string",
          "const": "Analysis complete. Entity 07 classified."
        },
        "fields": {
          "type": "object",
          "const": {
            "type": { "unknown": "???", "known": "GLASS" },
            "status": { "unknown": "???", "known": "STABLE" },
            "risk": { "unknown": "???", "known": "LOW" },
            "signature": { "unknown": "???", "known": "BLUE" }
          }
        }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["near", "deep", "panel", "blue", "pale", "mute"],
      "properties": {
        "near": { "type": "string", "const": "#020912" },
        "deep": { "type": "string", "const": "#0a1c30" },
        "panel": { "type": "string", "const": "#0f2438" },
        "blue": { "type": "string", "const": "#3f83d1" },
        "pale": { "type": "string", "const": "#cfe5ff" },
        "mute": { "type": "string", "const": "#6a8499" }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status", "risk", "signature"],
      "properties": {
        "type": { "type": "number", "const": 0.22 },
        "status": { "type": "number", "const": 0.4 },
        "risk": { "type": "number", "const": 0.58 },
        "signature": { "type": "number", "const": 0.76 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanMs", "gridWidthPx", "revealTranslatePercent", "easing"],
      "properties": {
        "scanMs": { "type": "number", "const": 720 },
        "direction": { "type": "string", "const": "left-to-right" },
        "gridWidthPx": { "type": "number", "const": 40 },
        "revealTranslatePercent": { "type": "number", "const": 110 },
        "noFade": { "type": "boolean", "const": true },
        "easing": {
          "type": "string",
          "const": "cubic-bezier(0.33, 0, 0.2, 1)"
        }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["realAnalyseButton", "decorativeScanHidden", "statusAnnouncement"],
      "properties": {
        "realAnalyseButton": { "type": "boolean", "const": true },
        "decorativeScanHidden": { "type": "boolean", "const": true },
        "statusAnnouncement": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateReveal", "triggers"],
      "properties": {
        "immediateReveal": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "prefers-reduced-motion: reduce",
              "data-force-reduced-motion=true"
            ]
          }
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "card", "beam", "complete", "analyse"],
      "properties": {
        "root": { "type": "string", "const": "esr" },
        "card": { "type": "string", "const": "esr__card" },
        "beam": { "type": "string", "const": "esr__beam" },
        "complete": { "type": "string", "const": "esr__complete" },
        "analyse": { "type": "string", "const": "esr__btn" },
        "stateDone": { "type": "string", "const": "esr--done" }
      }
    }
  },
  "examples": [
    {
      "name": "enemy-scan-reveal",
      "intent": "A target begins with unknown metadata; a vertical scanner travels left to right and reveals each property when it crosses a fixed x-threshold.",
      "thresholds": {
        "type": 0.22,
        "status": 0.4,
        "risk": 0.58,
        "signature": 0.76
      },
      "animation": {
        "scanMs": 720,
        "gridWidthPx": 40,
        "revealTranslatePercent": 110,
        "noFade": true,
        "easing": "cubic-bezier(0.33, 0, 0.2, 1)"
      },
      "reducedMotion": {
        "immediateReveal": true,
        "triggers": [
          "prefers-reduced-motion: reduce",
          "data-force-reduced-motion=true"
        ]
      }
    }
  ]
}
