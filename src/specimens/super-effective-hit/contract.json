{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/super-effective-hit.schema.json",
  "title": "SuperEffectiveHit",
  "description": "Portable contract for action→contact→ordinary response→effectiveness amplification→OPTIMAL feedback with six angular wedges.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "colours",
    "animation",
    "wedges",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "super-effective-hit" },
    "intent": {
      "type": "string",
      "const": "Action token hits a target card; a small contact response is followed by a stronger secondary effectiveness burst, then MATCH // OPTIMAL."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "initialMatch",
        "finalMatch",
        "effectiveness",
        "trigger",
        "reset"
      ],
      "properties": {
        "title": { "type": "string", "const": "CACHE STRATEGY" },
        "initialMatch": { "type": "string", "const": "MATCH // UNKNOWN" },
        "finalMatch": { "type": "string", "const": "MATCH // OPTIMAL" },
        "effectiveness": { "type": "string", "const": "HIGH EFFECTIVENESS" },
        "trigger": { "type": "string", "const": "APPLY" },
        "reset": { "type": "string", "const": "RESET" }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "paper", "amber", "gold", "coral"],
      "properties": {
        "ink": { "type": "string", "const": "#161d21" },
        "paper": { "type": "string", "const": "#f4f1df" },
        "amber": { "type": "string", "const": "#e39b3a" },
        "gold": { "type": "string", "const": "#f4d35e" },
        "coral": { "type": "string", "const": "#e85b4a" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenStartOffsetPx",
        "travelTranslateXPx",
        "travelMs",
        "contactMs",
        "contactScale",
        "contactTranslateXPx",
        "secondaryDelayMs",
        "ampMs",
        "ampScale",
        "slashDeg",
        "slashMs",
        "totalMsApprox",
        "loops"
      ],
      "properties": {
        "tokenStartOffsetPx": { "type": "number", "const": -90 },
        "travelTranslateXPx": { "type": "number", "const": 82 },
        "travelMs": { "type": "number", "const": 150 },
        "contactMs": { "type": "number", "const": 60 },
        "contactScale": { "type": "array", "const": [1, 0.96] },
        "contactTranslateXPx": { "type": "number", "const": 4 },
        "secondaryDelayMs": { "type": "number", "const": 55 },
        "ampMs": { "type": "number", "const": 170 },
        "ampScale": { "type": "array", "const": [0.98, 1.035, 1] },
        "slashDeg": { "type": "number", "const": -12 },
        "slashMs": { "type": "number", "const": 120 },
        "wedgeMs": { "type": "number", "const": 130 },
        "totalMsApprox": { "type": "array", "const": [500, 600] },
        "statusSwap": { "type": "string", "const": "vertical-clip" },
        "loops": { "type": "boolean", "const": false }
      }
    },
    "wedges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "lengthsPx", "rotationsDeg"],
      "properties": {
        "count": { "type": "number", "const": 6 },
        "lengthsPx": {
          "type": "array",
          "const": [14, 26, 20, 34, 12, 22]
        },
        "rotationsDeg": {
          "type": "array",
          "const": [-70, -28, 8, 48, 110, 158]
        },
        "travelRangePx": { "type": "array", "const": [12, 34] }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statusText", "politeLive", "decorativeMotion"],
      "properties": {
        "statusText": { "type": "boolean", "const": true },
        "politeLive": { "type": "boolean", "const": true },
        "decorativeMotion": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateOptimal", "staticAccent", "triggers"],
      "properties": {
        "immediateOptimal": { "type": "boolean", "const": true },
        "staticAccent": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": [
            "prefers-reduced-motion: reduce",
            "data-force-reduced-motion=true"
          ]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "card", "token", "wedge"],
      "properties": {
        "root": { "type": "string", "const": "super-effective" },
        "card": { "type": "string", "const": "super-effective__card" },
        "token": { "type": "string", "const": "super-effective__token" },
        "wedge": { "type": "string", "const": "seh-wedge" }
      }
    }
  }
}
