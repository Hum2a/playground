{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/authentication-success-morph.schema.json",
  "title": "AuthenticationSuccessMorph",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "copy", "animation", "reducedMotion", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "authentication-success-morph" },
    "intent": {
      "type": "string",
      "const": "Transform an abstract scanning structure into a verified state using the same geometry."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialStatus", "finalStatus"],
      "properties": {
        "initialStatus": { "type": "string", "const": "VERIFYING" },
        "finalStatus": { "type": "string", "const": "VERIFIED" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bracketInwardPx", "bracketMs", "nodeMs", "nodeCount"],
      "properties": {
        "bracketInwardPx": { "type": "number", "const": 6 },
        "bracketMs": { "type": "number", "const": 100 },
        "nodeMs": { "type": "number", "const": 180 },
        "nodeCount": { "type": "number", "const": 8 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantVerified", "triggers"],
      "properties": {
        "instantVerified": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "field"],
      "properties": {
        "root": { "type": "string", "const": "asm" },
        "field": { "type": "string", "const": "asm__field" }
      }
    }
  }
}
