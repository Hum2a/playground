{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/multi-key-seal.schema.json",
  "title": "MultiKeySeal",
  "description": "Three prerequisite key nodes arm in order before triangular seal petals rotate open.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "keyCount", "keyStepMs", "petalOpenMs", "corePulseMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "multi-key-seal" },
    "keyCount": { "type": "number", "const": 3 },
    "keyStepMs": { "type": "number", "const": 150 },
    "petalOpenMs": { "type": "number", "const": 300 },
    "corePulseMs": { "type": "number", "const": 150 },
    "settleMs": { "type": "number", "const": 90 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateOpen"],
      "properties": {
        "immediateOpen": { "type": "boolean", "const": true }
      }
    }
  }
}
