{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/mission-incoming.schema.json",
  "title": "MissionIncoming",
  "description": "Portable contract for a mission dispatch card entry effect.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "colours", "animation", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "mission-incoming" },
    "intent": {
      "type": "string",
      "const": "Mission dispatch card enters from the right with speed lines and ALERT badge."
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "ink", "paper", "accent"],
      "properties": {
        "primary": { "type": "string", "const": "#38A3FF" },
        "ink": { "type": "string", "const": "#101820" },
        "paper": { "type": "string", "const": "#F4F7FA" },
        "accent": { "type": "string", "const": "#FF4D35" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enterMs", "totalMs", "loops"],
      "properties": {
        "enterMs": { "type": "number", "const": 420 },
        "totalMs": { "type": "number", "const": 1070 },
        "loops": { "type": "boolean", "const": false }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggers"],
      "properties": {
        "triggers": {
          "type": "array",
          "const": [
            "prefers-reduced-motion: reduce",
            "data-force-reduced-motion=true"
          ]
        }
      }
    }
  }
}
