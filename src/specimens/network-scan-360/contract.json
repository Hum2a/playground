{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/network-scan-360.schema.json",
  "title": "NetworkScan360",
  "description": "A radial sweep rotates a full circle from a central hub, wiring in five connected nodes as it crosses them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "nodeCount", "stepMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "network-scan-360" },
    "nodeCount": { "type": "number", "const": 5 },
    "stepMs": { "type": "number", "const": 150 },
    "settleMs": { "type": "number", "const": 100 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alert", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "alert": { "type": "string", "const": "#D94A38" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateMapped"],
      "properties": {
        "immediateMapped": { "type": "boolean", "const": true }
      }
    }
  }
}
