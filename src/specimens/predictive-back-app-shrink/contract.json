{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/predictive-back-app-shrink.schema.json",
  "title": "PredictiveBackAppShrink",
  "description": "Portable contract for Android-inspired back gesture that shrinks the app surface into a floating card.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "preview",
    "gesture",
    "transform",
    "settle",
    "animation",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "predictive-back-app-shrink" },
    "intent": {
      "type": "string",
      "const": "Left-edge back gesture maps 0→160px drag to scale 1→0.88, radius 0→32px, translateX 0→46px, inset 0→18px; commit at 118px."
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx"],
      "properties": {
        "widthPx": { "type": "number", "const": 390 },
        "heightPx": { "type": "number", "const": 720 }
      }
    },
    "gesture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeZonePx", "maxDragPx", "commitPx"],
      "properties": {
        "edgeZonePx": { "type": "number", "const": 24 },
        "maxDragPx": { "type": "number", "const": 160 },
        "commitPx": { "type": "number", "const": 118 }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scaleMin", "radiusMaxPx", "translateMaxPx", "insetMaxPx", "borderBelowScale"],
      "properties": {
        "scaleMin": { "type": "number", "const": 0.88 },
        "radiusMaxPx": { "type": "number", "const": 32 },
        "translateMaxPx": { "type": "number", "const": 46 },
        "insetMaxPx": { "type": "number", "const": 18 },
        "borderBelowScale": { "type": "number", "const": 0.97 }
      }
    },
    "settle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitMs", "cancelMs"],
      "properties": {
        "commitMs": { "type": "number", "const": 180 },
        "cancelMs": { "type": "number", "const": 220 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loops", "finalStatic"],
      "properties": {
        "loops": { "type": "boolean", "const": false },
        "finalStatic": { "type": "boolean", "const": true }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["politeStatus"],
      "properties": {
        "politeStatus": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keepGesturePreview", "noScaleAfterRelease", "triggers"],
      "properties": {
        "keepGesturePreview": { "type": "boolean", "const": true },
        "noScaleAfterRelease": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": [
            "prefers-reduced-motion: reduce",
            "data-force-reduced-motion=true"
          ]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "stage", "surface", "underlay", "edge"],
      "properties": {
        "root": { "type": "string", "const": "pbas" },
        "stage": { "type": "string", "const": "pbas__stage" },
        "surface": { "type": "string", "const": "pbas__surface" },
        "underlay": { "type": "string", "const": "pbas__underlay" },
        "edge": { "type": "string", "const": "pbas__edge" }
      }
    }
  }
}
