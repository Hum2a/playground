{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/fingerprint-acquisition-field.schema.json",
  "title": "FingerprintAcquisitionField",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "acquisition", "reducedMotion", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "fingerprint-acquisition-field" },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holdMs", "rewindBeforeMs", "segmentCount", "failPulseMs"],
      "properties": {
        "holdMs": { "type": "number", "const": 900 },
        "rewindBeforeMs": { "type": "number", "const": 720 },
        "segmentCount": { "type": "number", "const": 12 },
        "failPulseMs": { "type": "number", "const": 220 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discreteStages", "triggers"],
      "properties": {
        "discreteStages": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "target", "seg", "check"],
      "properties": {
        "root": { "type": "string", "const": "faf" },
        "target": { "type": "string", "const": "faf__target" },
        "seg": { "type": "string", "const": "faf__seg" },
        "check": { "type": "string", "const": "faf__check" }
      }
    }
  }
}
