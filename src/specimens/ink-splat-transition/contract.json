      "droplets": [
        { "className": "ink-splat__drop--a", "dx": -26, "dy": -20, "size": [10, 9] },
        { "className": "ink-splat__drop--b", "dx": 28, "dy": -15, "size": [8, 8] },
        { "className": "ink-splat__drop--c", "dx": -20, "dy": 28, "size": [11, 10] },
        { "className": "ink-splat__drop--d", "dx": 22, "dy": 24, "size": [7, 8] },
