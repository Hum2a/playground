{
  "name": "ink-splat-transition",
  "intent": "Seven irregular ink blobs with satellite droplets strike and expand to full purple coverage for a content swap, then peel away toward off-centre origins in a non-mirrored exit.",
  "colours": {
    "purple": "#7c28d9",
    "lime": "#b7ef32",
    "ink": "#17151d",
    "paper": "#f7f5ed"
  },
  "backing": {
    "className": "ink-splat__backing",
    "colour": "#7c28d9",
    "borderRadius": "58% 42% 63% 37% / 48% 55% 45% 52%",
    "size": "160vmax",
    "enter": "scaleFromTiny",
    "exit": "scalePeelToBottomLeft",
    "enterDelayMs": 280,
    "enterMs": 240,
    "exitMs": 520,
    "exitDelayMs": 40,
    "exitTransformOrigin": "12% 88%"
  },
  "splats": [
    {
      "id": 1,
      "className": "ink-splat__splat--1",
      "role": "impact",
      "colour": "#7c28d9",
      "top": "18%",
      "left": "22%",
      "coreSize": ["42vmin", "38vmin"],
      "borderRadius": "63% 37% 54% 46% / 55% 48% 52% 45%",
      "delayMs": 0,
      "enterMs": 220,
      "exitMs": 480,
      "exitDelayMs": 0,
      "exitTo": "up-left",
      "droplets": [
        { "className": "ink-splat__drop--a", "dx": -28, "dy": -22, "size": [12, 11] },
        { "className": "ink-splat__drop--b", "dx": 32, "dy": -18, "size": [9, 10] },
        { "className": "ink-splat__drop--c", "dx": -18, "dy": 30, "size": [11, 9] },
        { "className": "ink-splat__drop--d", "dx": 24, "dy": 26, "size": [8, 8] }
      ]
    },
    {
      "id": 2,
      "className": "ink-splat__splat--2",
      "role": "impact",
      "colour": "#7c28d9",
      "top": "24%",
      "left": "72%",
      "coreSize": ["36vmin", "40vmin"],
      "borderRadius": "42% 58% 48% 52% / 60% 40% 55% 45%",
      "delayMs": 70,
      "enterMs": 220,
      "exitMs": 460,
      "exitDelayMs": 40,
      "exitTo": "up-right",
      "droplets": [
        { "className": "ink-splat__drop--a", "dx": 30, "dy": -24, "size": [11, 10] },
        { "className": "ink-splat__drop--b", "dx": -22, "dy": -16, "size": [8, 9] },
        { "className": "ink-splat__drop--c", "dx": 18, "dy": 34, "size": [10, 8] }
      ]
    },
    {
      "id": 3,
      "className": "ink-splat__splat--3",
      "role": "impact-accent",
