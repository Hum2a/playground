      "coreSize": ["78vmin", "72vmin"],
      "borderRadius": "48% 52% 58% 42% / 55% 45% 52% 48%",
      "delayMs": 280,
      "enterMs": 240,
      "exitMs": 540,
      "exitDelayMs": 0,
