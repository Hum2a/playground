{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "map-construction",
  "description": "Explored corridors draw themselves as movement progresses.",
  "type": "object",
  "required": [
    "name",
    "intent",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "map-construction"
    },
    "intent": {
      "type": "string",
      "const": "Explored corridors draw themselves as movement progresses."
    },
    "colours": {
      "type": "object",
      "properties": {
        "yellow": {
          "const": "#F5C400"
        },
        "ink": {
          "const": "#101010"
        },
        "paper": {
          "const": "#F7F3E8"
        },
        "gray": {
          "const": "#E8E8E8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "properties": {
        "triggers": {
          "type": "array",
          "items": {
            "enum": [
              "prefers-reduced-motion: reduce",
              "data-force-reduced-motion=true"
            ]
          }
        }
      }
    }
  }
}