{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/lightning-target-acquisition.schema.json",
  "title": "LightningTargetAcquisition",
  "description": "A loose reticle snaps onto a fixed target with branching marks that flicker just before locking solid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "snapMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "lightning-target-acquisition" },
    "snapMs": { "type": "number", "const": 440 },
    "settleMs": { "type": "number", "const": 150 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "danger", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "danger": { "type": "string", "const": "#D94A38" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateLock"],
      "properties": {
        "immediateLock": { "type": "boolean", "const": true }
      }
    }
  }
}
