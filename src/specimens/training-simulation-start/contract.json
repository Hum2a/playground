{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.local/docs/design/training-simulation-start.schema.json",
  "title": "TrainingSimulationStart",
  "description": "Portable contract for READY countdown to telemetry burst.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "colours", "phases", "reducedMotion", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "training-simulation-start" },
    "intent": {
      "type": "string",
      "examples": ["READY countdown explodes into active telemetry."]
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "ink", "paper", "accent"],
      "properties": {
        "primary": { "type": "string", "const": "#38A3FF" },
        "ink": { "type": "string", "const": "#101820" },
        "paper": { "type": "string", "const": "#F4F7FA" },
        "accent": { "type": "string", "const": "#FF4D35" }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepMs", "burstMs"],
      "properties": {
        "stepMs": { "type": "number", "const": 380 },
        "burstMs": { "type": "number", "const": 580 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantTelemetry", "triggers"],
      "properties": {
        "instantTelemetry": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "prefers-reduced-motion: reduce",
              "data-force-reduced-motion=true"
            ]
          }
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "ready", "telemetry"],
      "properties": {
        "root": { "type": "string", "const": "tss" },
        "ready": { "type": "string", "const": "tss__ready" },
        "telemetry": { "type": "string", "const": "tss__telemetry" }
      }
    },
    "behaviour": {
      "type": "object",
      "properties": {
        "api": { "type": "string", "const": "trainingSimulationStart" }
      }
    }
  }
}
