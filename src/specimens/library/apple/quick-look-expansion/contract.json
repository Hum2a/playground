{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/quick-look-expansion.schema.json",
  "title": "QuickLookExpansion",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "copy", "row", "preview", "animation", "reducedMotion", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "quick-look-expansion" },
    "intent": {
      "type": "string",
      "const": "Expand a selected file representation into a larger preview while keeping surrounding file context visible."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedFile"],
      "properties": {
        "selectedFile": { "type": "string", "const": "DESIGN.PDF" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heightPx", "count"],
      "properties": {
        "heightPx": { "type": "number", "const": 52 },
        "count": { "type": "number", "const": 5 }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx", "contentBlocks"],
      "properties": {
        "widthPx": { "type": "number", "const": 420 },
        "heightPx": { "type": "number", "const": 330 },
        "contentBlocks": { "type": "number", "const": 3 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs", "listScale", "blockStaggerMs"],
      "properties": {
        "durationMs": { "type": "number", "const": 380 },
        "listScale": { "type": "number", "const": 0.985 },
        "blockStaggerMs": { "type": "number", "const": 45 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantToggle", "triggers"],
      "properties": {
        "instantToggle": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "preview"],
      "properties": {
        "root": { "type": "string", "const": "qle" },
        "preview": { "type": "string", "const": "qle__preview" }
      }
    }
  }
}
