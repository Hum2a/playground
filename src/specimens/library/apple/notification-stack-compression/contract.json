{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/notification-stack-compression.schema.json",
  "title": "NotificationStackCompression",
  "description": "Portable contract for three notifications compressing into a layered stack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "colours",
    "cards",
    "compression",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "notification-stack-compression" },
    "intent": {
      "type": "string",
      "const": "Three notifications condense into one three-layer stack with counter 3 NOTIFICATIONS; EXPAND restores spacing."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notifications", "counter"],
      "properties": {
        "notifications": {
          "type": "array",
          "const": ["BUILD COMPLETE", "REVIEW REQUESTED", "DEPLOY READY"]
        },
        "counter": { "type": "string", "const": "3 NOTIFICATIONS" }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "panel", "line", "muted", "cream", "accent"],
      "properties": {
        "ink": { "type": "string", "const": "#101218" },
        "panel": { "type": "string", "const": "#1a1f28" },
        "line": { "type": "string", "const": "#2d3542" },
        "muted": { "type": "string", "const": "#7c8696" },
        "cream": { "type": "string", "const": "#e9edf3" },
        "accent": { "type": "string", "const": "#6fa3d8" }
      }
    },
    "cards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "widthPx", "heightPx", "gapPx"],
      "properties": {
        "count": { "type": "number", "const": 3 },
        "widthPx": { "type": "number", "const": 320 },
        "heightPx": { "type": "number", "const": 74 },
        "gapPx": { "type": "number", "const": 12 }
      }
    },
    "compression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs", "offsets", "scales"],
      "properties": {
        "durationMs": { "type": "number", "const": 320 },
        "offsets": {
          "type": "object",
          "const": { "middle": 6, "bottom": 12 }
        },
        "scales": {
          "type": "object",
          "const": { "top": 1, "middle": 0.98, "bottom": 0.96 }
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantLayout", "triggers"],
      "properties": {
        "instantLayout": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": [
            "prefers-reduced-motion: reduce",
            "data-force-reduced-motion=true"
          ]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "stack", "card", "counter"],
      "properties": {
        "root": { "type": "string", "const": "nsc" },
        "stack": { "type": "string", "const": "nsc__stack" },
        "card": { "type": "string", "const": "nsc__card" },
        "counter": { "type": "string", "const": "nsc__counter" }
      }
    }
  }
}
