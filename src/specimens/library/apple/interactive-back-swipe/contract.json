{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/interactive-back-swipe.schema.json",
  "title": "InteractiveBackSwipe",
  "description": "Portable contract for edge-initiated back navigation with position and velocity commit thresholds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "colours",
    "preview",
    "surfaces",
    "gesture",
    "settle",
    "hint",
    "animation",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "interactive-back-swipe" },
    "intent": {
      "type": "string",
      "const": "Horizontal back gesture: current surface follows drag 1:1 while previous surface reveals from -28% scale .98; commit at 42% width or velocity >0.62 px/ms."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous", "current", "backLabel", "replay"],
      "properties": {
        "previous": { "type": "string", "const": "PROJECTS" },
        "current": { "type": "string", "const": "PROJECT // ORBIT" },
        "backLabel": { "type": "string", "const": "PROJECTS" },
        "replay": { "type": "string", "const": "REPLAY" }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "panel", "line", "muted", "text", "accent", "pale"],
      "properties": {
        "ink": { "type": "string", "const": "#12141a" },
        "panel": { "type": "string", "const": "#1a1f28" },
        "line": { "type": "string", "const": "#2c3440" },
        "muted": { "type": "string", "const": "#6b7585" },
        "text": { "type": "string", "const": "#e8ecf2" },
        "accent": { "type": "string", "const": "#5a8fd4" },
        "pale": { "type": "string", "const": "#9eb8e0" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx"],
      "properties": {
        "widthPx": { "type": "number", "const": 420 },
        "heightPx": { "type": "number", "const": 560 }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousRest", "currentRest"],
      "properties": {
        "previousRest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["translateXPercent", "scale", "opacity"],
          "properties": {
            "translateXPercent": { "type": "number", "const": -28 },
            "scale": { "type": "number", "const": 0.98 },
            "opacity": { "type": "number", "const": 0.72 }
          }
        },
        "currentRest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["translateXPx"],
          "properties": {
            "translateXPx": { "type": "number", "const": 0 }
          }
        }
      }
    },
    "gesture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeZonePx",
        "dragMapping",
        "commitWidthRatio",
        "velocityCommitPxMs"
      ],
      "properties": {
        "edgeZonePx": { "type": "number", "const": 28 },
        "dragMapping": { "type": "string", "const": "current 1:1; previous -28%→0%; opacity .72→1" },
        "commitWidthRatio": { "type": "number", "const": 0.42 },
        "velocityCommitPxMs": { "type": "number", "const": 0.62 }
      }
    },
    "settle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitMs", "cancelMs"],
      "properties": {
        "commitMs": { "type": "number", "const": 260 },
        "cancelMs": { "type": "number", "const": 220 }
      }
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chevron", "label", "thresholdTickPx", "thresholdPositionRatio"],
      "properties": {
        "chevron": { "type": "boolean", "const": true },
        "label": { "type": "string", "const": "PROJECTS" },
        "thresholdTickPx": { "type": "number", "const": 2 },
        "thresholdPositionRatio": { "type": "number", "const": 0.42 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loops", "finalStatic"],
      "properties": {
        "loops": { "type": "boolean", "const": false },
        "finalStatic": { "type": "boolean", "const": true }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["politeStatus"],
      "properties": {
        "politeStatus": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keepThresholds", "noParallaxScale", "immediateCommit", "triggers"],
      "properties": {
        "keepThresholds": { "type": "boolean", "const": true },
        "noParallaxScale": { "type": "boolean", "const": true },
        "immediateCommit": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": [
            "prefers-reduced-motion: reduce",
            "data-force-reduced-motion=true"
          ]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "stage", "previous", "current", "edge", "hint", "tick"],
      "properties": {
        "root": { "type": "string", "const": "ibs" },
        "stage": { "type": "string", "const": "ibs__stage" },
        "previous": { "type": "string", "const": "ibs__previous" },
        "current": { "type": "string", "const": "ibs__current" },
        "edge": { "type": "string", "const": "ibs__edge" },
        "hint": { "type": "string", "const": "ibs__hint" },
        "tick": { "type": "string", "const": "ibs__tick" }
      }
    }
  }
}
