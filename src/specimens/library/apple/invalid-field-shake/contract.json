{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/invalid-field-shake.schema.json",
  "title": "InvalidFieldShake",
  "description": "Portable contract for finite validation shake and inline error expansion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "field",
    "shake",
    "error",
    "validation",
    "reducedMotion",
    "a11y",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "invalid-field-shake" },
    "intent": {
      "type": "string",
      "const": "Compact finite validation refusal for form fields with exact shake offsets and inline error region."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "initialValue", "errorText", "validValue"],
      "properties": {
        "label": { "type": "string", "const": "PROJECT CODE" },
        "initialValue": { "type": "string", "const": "ORBIT?" },
        "errorText": { "type": "string", "const": "Use A–Z, 0–9 or -" },
        "validValue": { "type": "string", "const": "ORBIT-7" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx"],
      "properties": {
        "widthPx": { "type": "number", "const": 300 }
      }
    },
    "shake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offsetsPx", "durationMs"],
      "properties": {
        "offsetsPx": {
          "type": "array",
          "const": [0, -6, 5, -4, 3, -2, 0]
        },
        "durationMs": { "type": "number", "const": 310 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expandDelayMs", "heightPx", "tickCount"],
      "properties": {
        "expandDelayMs": { "type": "number", "const": 90 },
        "heightPx": { "type": "number", "const": 34 },
        "tickCount": { "type": "number", "const": 1 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": {
        "pattern": { "type": "string", "const": "^[A-Z0-9-]+$" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noShake", "triggers"],
      "properties": {
        "noShake": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": [
            "prefers-reduced-motion: reduce",
            "data-force-reduced-motion=true"
          ]
        }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorAlert", "politeStatus"],
      "properties": {
        "errorAlert": { "type": "boolean", "const": true },
        "politeStatus": { "type": "boolean", "const": true }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "field", "error"],
      "properties": {
        "root": { "type": "string", "const": "ifs" },
        "field": { "type": "string", "const": "ifs__field" },
        "error": { "type": "string", "const": "ifs__error" }
      }
    }
  }
}
