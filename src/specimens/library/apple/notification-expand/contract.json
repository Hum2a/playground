{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/notification-expand.schema.json",
  "title": "NotificationExpand",
  "description": "Portable contract for compact notification expanding into actionable detail.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "colours",
    "geometry",
    "expansion",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "notification-expand" },
    "intent": {
      "type": "string",
      "const": "Compact notification expands into actionable detail; title identity persists; CLOSE collapses."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "details", "actions"],
      "properties": {
        "title": { "type": "string", "const": "REVIEW REQUEST" },
        "subtitle": { "type": "string", "const": "Mina requested approval" },
        "details": {
          "type": "array",
          "const": ["PR #184", "12 files changed"]
        },
        "actions": {
          "type": "array",
          "const": ["OPEN", "APPROVE"]
        }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "panel", "line", "muted", "cream", "accent"],
      "properties": {
        "ink": { "type": "string", "const": "#101218" },
        "panel": { "type": "string", "const": "#1a1f28" },
        "line": { "type": "string", "const": "#2d3542" },
        "muted": { "type": "string", "const": "#7c8696" },
        "cream": { "type": "string", "const": "#e9edf3" },
        "accent": { "type": "string", "const": "#6fa3d8" }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compactWidthPx", "compactHeightPx", "expandedWidthPx", "expandedHeightPx"],
      "properties": {
        "compactWidthPx": { "type": "number", "const": 330 },
        "compactHeightPx": { "type": "number", "const": 76 },
        "expandedWidthPx": { "type": "number", "const": 330 },
        "expandedHeightPx": { "type": "number", "const": 184 }
      }
    },
    "expansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs", "detailThresholdPx", "buttonStaggerMs"],
      "properties": {
        "durationMs": { "type": "number", "const": 280 },
        "detailThresholdPx": { "type": "number", "const": 120 },
        "buttonStaggerMs": { "type": "number", "const": 40 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantLayout", "triggers"],
      "properties": {
        "instantLayout": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": [
            "prefers-reduced-motion: reduce",
            "data-force-reduced-motion=true"
          ]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "card", "title", "details"],
      "properties": {
        "root": { "type": "string", "const": "nex" },
        "card": { "type": "string", "const": "nex__card" },
        "title": { "type": "string", "const": "nex__title" },
        "details": { "type": "string", "const": "nex__details" }
      }
    }
  }
}
