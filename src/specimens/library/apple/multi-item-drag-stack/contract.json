{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/multi-item-drag-stack.schema.json",
  "title": "MultiItemDragStack",
  "description": "Portable contract for multi-item drag stack formation and drop.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "colours",
    "stack",
    "drag",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "multi-item-drag-stack" },
    "intent": {
      "type": "string",
      "const": "Four selected files condense into portable drag stack; count badge 4; drop absorbs sequentially."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "trigger", "target"],
      "properties": {
        "files": {
          "type": "array",
          "const": ["A.MD", "B.PDF", "C.PNG", "D.JSON"]
        },
        "trigger": { "type": "string", "const": "START DRAG" },
        "target": { "type": "string", "const": "DROP HERE" }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "panel", "line", "muted", "cream", "accent"],
      "properties": {
        "ink": { "type": "string", "const": "#0f1218" },
        "panel": { "type": "string", "const": "#1a1f28" },
        "line": { "type": "string", "const": "#2d3542" },
        "muted": { "type": "string", "const": "#7c8696" },
        "cream": { "type": "string", "const": "#e9edf3" },
        "accent": { "type": "string", "const": "#6fa3d8" }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemCount", "proxyWidthPx", "proxyHeightPx", "offsets", "scales", "badge"],
      "properties": {
        "itemCount": { "type": "number", "const": 4 },
        "proxyWidthPx": { "type": "number", "const": 108 },
        "proxyHeightPx": { "type": "number", "const": 58 },
        "offsets": { "type": "array", "const": [0, 4, 8, 12] },
        "scales": { "type": "array", "const": [1, 0.98, 0.96, 0.94] },
        "badge": { "type": "number", "const": 4 }
      }
    },
    "drag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formationStaggerMs", "dropStaggerMs"],
      "properties": {
        "formationStaggerMs": { "type": "number", "const": 45 },
        "dropStaggerMs": { "type": "number", "const": 35 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantStack", "triggers"],
      "properties": {
        "instantStack": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": [
            "prefers-reduced-motion: reduce",
            "data-force-reduced-motion=true"
          ]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "source", "stack", "proxy", "badge"],
      "properties": {
        "root": { "type": "string", "const": "mds" },
        "source": { "type": "string", "const": "mds__card" },
        "stack": { "type": "string", "const": "mds__stack" },
        "proxy": { "type": "string", "const": "mds__proxy" },
        "badge": { "type": "string", "const": "mds__badge" }
      }
    }
  }
}
