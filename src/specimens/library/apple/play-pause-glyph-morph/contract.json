{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/play-pause-glyph-morph.schema.json",
  "title": "PlayPauseGlyphMorph",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "copy", "control", "animation", "reducedMotion", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "play-pause-glyph-morph" },
    "intent": {
      "type": "string",
      "const": "One control whose line geometry directly transforms between play and pause states instead of cross-fading unrelated icons."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track", "initialState"],
      "properties": {
        "track": { "type": "string", "const": "SIGNAL // 04" },
        "initialState": { "type": "string", "const": "PLAY" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx", "pressScale"],
      "properties": {
        "widthPx": { "type": "number", "const": 48 },
        "heightPx": { "type": "number", "const": 48 },
        "pressScale": { "type": "number", "const": 0.96 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playToPauseMs", "pauseToPlayMs", "labelSwapAtPct"],
      "properties": {
        "playToPauseMs": { "type": "number", "const": 180 },
        "pauseToPlayMs": { "type": "number", "const": 160 },
        "labelSwapAtPct": { "type": "number", "const": 50 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantSwap", "triggers"],
      "properties": {
        "instantSwap": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "control"],
      "properties": {
        "root": { "type": "string", "const": "ppg" },
        "control": { "type": "string", "const": "ppg__control" }
      }
    }
  }
}
