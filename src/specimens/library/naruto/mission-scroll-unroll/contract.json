{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/mission-scroll-unroll.schema.json",
  "title": "MissionScrollUnroll",
  "description": "Rolled parchment expands by height (16→190px) then four briefing lines unclip with a 70ms stagger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "unrollMs",
    "lineStartMs",
    "lineStaggerMs",
    "lineCount",
    "settleMs",
    "rolledHeightPx",
    "openHeightPx",
    "briefingLines",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": { "type": "string", "const": "mission-scroll-unroll" },
    "unrollMs": { "type": "number", "const": 480 },
    "lineStartMs": { "type": "number", "const": 280 },
    "lineStaggerMs": { "type": "number", "const": 70 },
    "lineCount": { "type": "number", "const": 4 },
    "settleMs": { "type": "number", "const": 90 },
    "rolledHeightPx": { "type": "number", "const": 16 },
    "openHeightPx": { "type": "number", "const": 190 },
    "briefingLines": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "string" },
      "const": ["RANK B", "Retrieve the Sealed Scroll", "—", "Escort · Recon · No engagement"]
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#1A1612" },
        "parchment": { "type": "string", "const": "#EBE2D0" },
        "chakra": { "type": "string", "const": "#B83228" },
        "olive": { "type": "string", "const": "#6A5E4E" },
        "off": { "type": "string", "const": "#F7F2E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateOpen"],
      "properties": {
        "immediateOpen": { "type": "boolean", "const": true }
      }
    }
  }
}
