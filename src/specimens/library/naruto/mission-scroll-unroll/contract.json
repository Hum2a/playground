{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/mission-scroll-unroll.schema.json",
  "title": "MissionScrollUnroll",
  "description": "Rolled scroll expands and reveals four staggered briefing lines.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "unrollMs", "lineStaggerMs", "lineCount", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "mission-scroll-unroll" },
    "unrollMs": { "type": "number", "const": 480 },
    "lineStaggerMs": { "type": "number", "const": 70 },
    "lineCount": { "type": "number", "const": 4 },
    "settleMs": { "type": "number", "const": 90 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#1A1612" },
        "parchment": { "type": "string", "const": "#EBE2D0" },
        "chakra": { "type": "string", "const": "#B83228" },
        "olive": { "type": "string", "const": "#6A5E4E" },
        "off": { "type": "string", "const": "#F7F2E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateOpen"],
      "properties": {
        "immediateOpen": { "type": "boolean", "const": true }
      }
    }
  }
}
