{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/hand-sign-combo-sequence.schema.json",
  "title": "HandSignComboSequence",
  "description": "Four abstract command glyphs acquire one-by-one into a resolved READY sequence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "signCount", "stepMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "hand-sign-combo-sequence" },
    "signCount": { "type": "number", "const": 4 },
    "stepMs": { "type": "number", "const": 130 },
    "settleMs": { "type": "number", "const": 90 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#140C0C" },
        "parchment": { "type": "string", "const": "#E8DCC8" },
        "chakra": { "type": "string", "const": "#C43C2E" },
        "olive": { "type": "string", "const": "#6B5048" },
        "off": { "type": "string", "const": "#F3EBE0" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateReady"],
      "properties": {
        "immediateReady": { "type": "boolean", "const": true }
      }
    }
  }
}
