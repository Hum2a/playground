{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/scroll-to-panel-transform.schema.json",
  "title": "ScrollToPanelTransform",
  "description": "A round scroll token morphs shape into a rectangular content panel with a crossfading glyph/copy swap.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "morphMs", "glyphFadeMs", "copyFadeMs", "copyFadeStartMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "scroll-to-panel-transform" },
    "morphMs": { "type": "number", "const": 480 },
    "glyphFadeMs": { "type": "number", "const": 150 },
    "copyFadeMs": { "type": "number", "const": 220 },
    "copyFadeStartMs": { "type": "number", "const": 260 },
    "settleMs": { "type": "number", "const": 90 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateOpen"],
      "properties": {
        "immediateOpen": { "type": "boolean", "const": true }
      }
    }
  }
}
