{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/water-wave-page-transition.schema.json",
  "title": "WaterWavePageTransition",
  "description": "A jagged wave mask sweeps horizontally across the stage, exchanging page content mid-sweep.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "swapAtMs",
    "totalMs",
    "settleMs",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "water-wave-page-transition"
    },
    "swapAtMs": {
      "type": "number",
      "const": 320
    },
    "totalMs": {
      "type": "number",
      "const": 650
    },
    "settleMs": {
      "type": "number",
      "const": 150
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#071018"
        },
        "parchment": {
          "type": "string",
          "const": "#C8D8E4"
        },
        "chakra": {
          "type": "string",
          "const": "#3A9EC9"
        },
        "olive": {
          "type": "string",
          "const": "#4A6A78"
        },
        "off": {
          "type": "string",
          "const": "#E8F2F8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateSwap"
      ],
      "properties": {
        "immediateSwap": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "wipeMs": {
      "type": "number",
      "const": 420
    },
    "clipSteps": {
      "type": "array",
      "const": [
        "inset(0 100% 0 0)",
        "inset(0 40% 0 0)",
        "inset(0 0 0 0)"
      ]
    }
  }
}
