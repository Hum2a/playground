{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/fireball-commit.schema.json",
  "title": "FireballCommit",
  "description": "Ember charge at source, launch 216px, impact flash, CONFIRMED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "chargeMs",
    "launchMs",
    "impactMs",
    "settleMs",
    "travelPx",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "fireball-commit"
    },
    "chargeMs": {
      "type": "number",
      "const": 380
    },
    "launchMs": {
      "type": "number",
      "const": 220
    },
    "impactMs": {
      "type": "number",
      "const": 200
    },
    "settleMs": {
      "type": "number",
      "const": 150
    },
    "travelPx": {
      "type": "number",
      "const": 216
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "danger",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#0C0806"
        },
        "parchment": {
          "type": "string",
          "const": "#C4B8A8"
        },
        "chakra": {
          "type": "string",
          "const": "#E07030"
        },
        "danger": {
          "type": "string",
          "const": "#D94A38"
        },
        "olive": {
          "type": "string",
          "const": "#5A5048"
        },
        "off": {
          "type": "string",
          "const": "#F4F1E8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateConfirmed"
      ],
      "properties": {
        "immediateConfirmed": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
