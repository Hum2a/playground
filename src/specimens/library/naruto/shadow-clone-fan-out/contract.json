{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/shadow-clone-fan-out.schema.json",
  "title": "ShadowCloneFanOut",
  "description": "Three clones puff-scale from origin and travel to worker slots with 70ms stagger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "cloneCount",
    "staggerMs",
    "fanMs",
    "settleMs",
    "targets",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "shadow-clone-fan-out"
    },
    "cloneCount": {
      "type": "number",
      "const": 3
    },
    "staggerMs": {
      "type": "number",
      "const": 70
    },
    "fanMs": {
      "type": "number",
      "const": 180
    },
    "settleMs": {
      "type": "number",
      "const": 90
    },
    "targets": {
      "type": "array",
      "const": [
        {
          "left": "16.6%",
          "top": "82%"
        },
        {
          "left": "50%",
          "top": "82%"
        },
        {
          "left": "83.4%",
          "top": "82%"
        }
      ]
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#12141A"
        },
        "parchment": {
          "type": "string",
          "const": "#D8D4E0"
        },
        "chakra": {
          "type": "string",
          "const": "#7A6B9A"
        },
        "olive": {
          "type": "string",
          "const": "#6E6A78"
        },
        "off": {
          "type": "string",
          "const": "#F0EEF4"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateFanned"
      ],
      "properties": {
        "immediateFanned": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
