{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/weak-point-detection.schema.json",
  "title": "WeakPointDetection",
  "description": "Four weak-point brackets appear on a host silhouette in order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "markerCount",
    "markerOrder",
    "stepMs",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "weak-point-detection"
    },
    "markerCount": {
      "type": "number",
      "const": 4
    },
    "markerOrder": {
      "type": "array",
      "const": [
        0,
        1,
        2,
        3
      ]
    },
    "stepMs": {
      "type": "number",
      "const": 140
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "olive",
        "off",
        "alert"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#070B0E"
        },
        "parchment": {
          "type": "string",
          "const": "#C8E8DC"
        },
        "chakra": {
          "type": "string",
          "const": "#3DCEA8"
        },
        "olive": {
          "type": "string",
          "const": "#1A6B58"
        },
        "off": {
          "type": "string",
          "const": "#D7F5EC"
        },
        "alert": {
          "type": "string",
          "const": "#3DCEA8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateDetected"
      ],
      "properties": {
        "immediateDetected": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
