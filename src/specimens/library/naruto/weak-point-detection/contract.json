{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/weak-point-detection.schema.json",
  "title": "WeakPointDetection",
  "description": "A scan line sweeps a wireframe diagram and brackets four weak points as it crosses them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "markerCount", "stepMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "weak-point-detection" },
    "markerCount": { "type": "number", "const": 4 },
    "stepMs": { "type": "number", "const": 160 },
    "settleMs": { "type": "number", "const": 100 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alert", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#070B0E" },
        "parchment": { "type": "string", "const": "#C8E8DC" },
        "chakra": { "type": "string", "const": "#3DCEA8" },
        "alert": { "type": "string", "const": "#3DCEA8" },
        "olive": { "type": "string", "const": "#1A6B58" },
        "off": { "type": "string", "const": "#D7F5EC" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateDetected"],
      "properties": {
        "immediateDetected": { "type": "boolean", "const": true }
      }
    }
  }
}
