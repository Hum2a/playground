{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/mission-complete-stamp.schema.json",
  "title": "MissionCompleteStamp",
  "description": "COMPLETE wax stamp slams at −18° then settles to −14° with one ring pulse.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "slamMs",
    "settleMs",
    "ringMs",
    "stampOvershootDeg",
    "stampSettleDeg",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "mission-complete-stamp"
    },
    "slamMs": {
      "type": "number",
      "const": 220
    },
    "settleMs": {
      "type": "number",
      "const": 100
    },
    "ringMs": {
      "type": "number",
      "const": 260
    },
    "stampOvershootDeg": {
      "type": "number",
      "const": -18
    },
    "stampSettleDeg": {
      "type": "number",
      "const": -14
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "alarm",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#1A1612"
        },
        "parchment": {
          "type": "string",
          "const": "#EBE2D0"
        },
        "chakra": {
          "type": "string",
          "const": "#B83228"
        },
        "alarm": {
          "type": "string",
          "const": "#B83228"
        },
        "olive": {
          "type": "string",
          "const": "#6A5E4E"
        },
        "off": {
          "type": "string",
          "const": "#F7F2E8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateComplete"
      ],
      "properties": {
        "immediateComplete": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
