{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/mission-board-dispatch.schema.json",
  "title": "MissionBoardDispatch",
  "description": "A job card travels from the unassigned board column into a team lane and docks beside its assignee.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "travelMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "mission-board-dispatch" },
    "travelMs": { "type": "number", "const": 260 },
    "settleMs": { "type": "number", "const": 200 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alarm", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#1A1612" },
        "parchment": { "type": "string", "const": "#EBE2D0" },
        "chakra": { "type": "string", "const": "#B83228" },
        "alarm": { "type": "string", "const": "#B83228" },
        "olive": { "type": "string", "const": "#6A5E4E" },
        "off": { "type": "string", "const": "#F7F2E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateAssigned"],
      "properties": {
        "immediateAssigned": { "type": "boolean", "const": true }
      }
    }
  }
}
