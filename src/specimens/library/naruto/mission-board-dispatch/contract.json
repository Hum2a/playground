{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/mission-board-dispatch.schema.json",
  "title": "MissionBoardDispatch",
  "description": "Job card travels from Unassigned into Team Lane along a frozen path then docks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "travelMs",
    "settleMs",
    "travelDxPx",
    "travelDyPx",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "mission-board-dispatch"
    },
    "travelMs": {
      "type": "number",
      "const": 280
    },
    "settleMs": {
      "type": "number",
      "const": 160
    },
    "travelDxPx": {
      "type": "number",
      "const": 148
    },
    "travelDyPx": {
      "type": "number",
      "const": 0
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "alarm",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#1A1612"
        },
        "parchment": {
          "type": "string",
          "const": "#EBE2D0"
        },
        "chakra": {
          "type": "string",
          "const": "#B83228"
        },
        "alarm": {
          "type": "string",
          "const": "#B83228"
        },
        "olive": {
          "type": "string",
          "const": "#6A5E4E"
        },
        "off": {
          "type": "string",
          "const": "#F7F2E8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateAssigned"
      ],
      "properties": {
        "immediateAssigned": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
