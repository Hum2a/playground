{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/healing-progress-field.schema.json",
  "title": "HealingProgressField",
  "description": "A damaged 5x5 tile grid heals in three concentric rings from the centre outward.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "ringCount", "stepMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "healing-progress-field" },
    "ringCount": { "type": "number", "const": 3 },
    "stepMs": { "type": "number", "const": 220 },
    "settleMs": { "type": "number", "const": 100 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alert", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#070B0E" },
        "parchment": { "type": "string", "const": "#C8E8DC" },
        "chakra": { "type": "string", "const": "#3DCEA8" },
        "alert": { "type": "string", "const": "#3DCEA8" },
        "olive": { "type": "string", "const": "#1A6B58" },
        "off": { "type": "string", "const": "#D7F5EC" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateRestored"],
      "properties": {
        "immediateRestored": { "type": "boolean", "const": true }
      }
    }
  }
}
