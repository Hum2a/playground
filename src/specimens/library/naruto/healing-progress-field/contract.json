{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/healing-progress-field.schema.json",
  "title": "HealingProgressField",
  "description": "Field tiles restore centre-out by frozen ring order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "tileCount",
    "ringCount",
    "healOrder",
    "stepMs",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "healing-progress-field"
    },
    "tileCount": {
      "type": "number",
      "const": 25
    },
    "ringCount": {
      "type": "number",
      "const": 3
    },
    "healOrder": {
      "type": "array",
      "const": [
        0,
        1,
        2
      ]
    },
    "stepMs": {
      "type": "number",
      "const": 160
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "olive",
        "off",
        "alert"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#070B0E"
        },
        "parchment": {
          "type": "string",
          "const": "#C8E8DC"
        },
        "chakra": {
          "type": "string",
          "const": "#3DCEA8"
        },
        "olive": {
          "type": "string",
          "const": "#1A6B58"
        },
        "off": {
          "type": "string",
          "const": "#D7F5EC"
        },
        "alert": {
          "type": "string",
          "const": "#3DCEA8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateRestored"
      ],
      "properties": {
        "immediateRestored": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
