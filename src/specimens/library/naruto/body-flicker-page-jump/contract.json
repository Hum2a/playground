{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/body-flicker-page-jump.schema.json",
  "title": "BodyFlickerPageJump",
  "description": "The current view flickers into compressed directional streaks, then hands off abruptly to a new destination view.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "flickerMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "body-flicker-page-jump" },
    "flickerMs": { "type": "number", "const": 140 },
    "settleMs": { "type": "number", "const": 90 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateArrival"],
      "properties": {
        "immediateArrival": { "type": "boolean", "const": true }
      }
    }
  }
}
