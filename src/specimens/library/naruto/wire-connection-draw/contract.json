{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/wire-connection-draw.schema.json",
  "title": "WireConnectionDraw",
  "description": "A thin wire rapidly connects two nodes, then both endpoints pulse to confirm a linked connection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "drawMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "wire-connection-draw" },
    "drawMs": { "type": "number", "const": 180 },
    "settleMs": { "type": "number", "const": 80 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#070B0E" },
        "parchment": { "type": "string", "const": "#C8E8DC" },
        "chakra": { "type": "string", "const": "#3DCEA8" },
        "olive": { "type": "string", "const": "#1A6B58" },
        "off": { "type": "string", "const": "#D7F5EC" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateLinked"],
      "properties": {
        "immediateLinked": { "type": "boolean", "const": true }
      }
    }
  }
}
