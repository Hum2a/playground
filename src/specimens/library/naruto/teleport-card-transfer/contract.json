{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/teleport-card-transfer.schema.json",
  "title": "TeleportCardTransfer",
  "description": "A card compresses at a source aperture and reconstructs at a destination aperture, teleporting instantly while invisible.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "compressMs", "reconstructMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "teleport-card-transfer" },
    "compressMs": { "type": "number", "const": 200 },
    "reconstructMs": { "type": "number", "const": 220 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alarm", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "alarm": { "type": "string", "const": "#D94A38" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateArrived"],
      "properties": {
        "immediateArrived": { "type": "boolean", "const": true }
      }
    }
  }
}
