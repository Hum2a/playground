{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/chakra-charge-field.schema.json",
  "title": "ChakraChargeField",
  "description": "Irregular chakra boundary grows through frozen diameters to READY.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "chargeMs",
    "commitMs",
    "diametersPx",
    "stepThresholds",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "chakra-charge-field"
    },
    "chargeMs": {
      "type": "number",
      "const": 620
    },
    "commitMs": {
      "type": "number",
      "const": 150
    },
    "diametersPx": {
      "type": "array",
      "const": [
        72,
        96,
        118,
        140
      ]
    },
    "stepThresholds": {
      "type": "array",
      "const": [
        0.25,
        0.5,
        0.75,
        1
      ]
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#070B0E"
        },
        "parchment": {
          "type": "string",
          "const": "#C8E8DC"
        },
        "chakra": {
          "type": "string",
          "const": "#3DCEA8"
        },
        "olive": {
          "type": "string",
          "const": "#1A6B58"
        },
        "off": {
          "type": "string",
          "const": "#D7F5EC"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateReady"
      ],
      "properties": {
        "immediateReady": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
