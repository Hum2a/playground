{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/chakra-charge-field.schema.json",
  "title": "ChakraChargeField",
  "description": "Irregular chakra boundary grows through frozen diameters to READY.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "diametersPx",
    "stepMs",
    "readyHoldMs",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "chakra-charge-field"
    },
    "diametersPx": {
      "type": "array",
      "const": [
        72,
        96,
        118,
        140
      ]
    },
    "stepMs": {
      "type": "number",
      "const": 140
    },
    "readyHoldMs": {
      "type": "number",
      "const": 180
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#070B0E"
        },
        "parchment": {
          "type": "string",
          "const": "#C8E8DC"
        },
        "chakra": {
          "type": "string",
          "const": "#3DCEA8"
        },
        "olive": {
          "type": "string",
          "const": "#1A6B58"
        },
        "off": {
          "type": "string",
          "const": "#D7F5EC"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateReady"
      ],
      "properties": {
        "immediateReady": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "acceptance": [
    "Boundary grows through frozen diameters 72→96→118→140px (data-step)",
    "Each step takes stepMs 140; final READY with readyHoldMs 180",
    "Motion language is width/height growth, not opacity fade",
    "Replay resets to 72px idle before rerunning",
    "Reduced motion shows READY at 140px immediately"
  ]
}
