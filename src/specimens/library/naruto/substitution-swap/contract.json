{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/substitution-swap.schema.json",
  "title": "SubstitutionSwap",
  "description": "A slot cross-fades primary target to proxy decoy to resolved failover target, with a puff at each swap.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "toDecoyMs", "decoyHoldMs", "toResolvedMs", "puffMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "substitution-swap" },
    "toDecoyMs": { "type": "number", "const": 100 },
    "decoyHoldMs": { "type": "number", "const": 180 },
    "toResolvedMs": { "type": "number", "const": 140 },
    "puffMs": { "type": "number", "const": 120 },
    "settleMs": { "type": "number", "const": 90 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#12141A" },
        "parchment": { "type": "string", "const": "#D8D4E0" },
        "chakra": { "type": "string", "const": "#7A6B9A" },
        "olive": { "type": "string", "const": "#6E6A78" },
        "off": { "type": "string", "const": "#F0EEF4" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateResolved"],
      "properties": {
        "immediateResolved": { "type": "boolean", "const": true }
      }
    }
  }
}
