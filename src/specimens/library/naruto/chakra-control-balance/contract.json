{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/chakra-control-balance.schema.json",
  "title": "ChakraControlBalance",
  "description": "Needle driven by two opposing holds must settle inside a narrow centre band to lock a balanced state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "sweepMs", "lockHoldMs", "lockPulseMs", "bandPct", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "chakra-control-balance" },
    "sweepMs": { "type": "number", "const": 560 },
    "lockHoldMs": { "type": "number", "const": 380 },
    "lockPulseMs": { "type": "number", "const": 150 },
    "bandPct": { "type": "number", "const": 8 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alert", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#070B0E" },
        "parchment": { "type": "string", "const": "#C8E8DC" },
        "chakra": { "type": "string", "const": "#3DCEA8" },
        "alert": { "type": "string", "const": "#3DCEA8" },
        "olive": { "type": "string", "const": "#1A6B58" },
        "off": { "type": "string", "const": "#D7F5EC" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantLock"],
      "properties": {
        "instantLock": { "type": "boolean", "const": true }
      }
    }
  }
}
