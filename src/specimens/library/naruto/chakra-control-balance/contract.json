{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/chakra-control-balance.schema.json",
  "title": "ChakraControlBalance",
  "description": "Needle/dual fill seeks centre band and locks within frozen threshold.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "lockThreshold",
    "wobble",
    "lockHoldMs",
    "lockPulseMs",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "chakra-control-balance"
    },
    "lockThreshold": {
      "type": "number",
      "const": 0.08
    },
    "wobble": {
      "type": "number",
      "const": 0.035
    },
    "lockHoldMs": {
      "type": "number",
      "const": 380
    },
    "lockPulseMs": {
      "type": "number",
      "const": 150
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#070B0E"
        },
        "parchment": {
          "type": "string",
          "const": "#C8E8DC"
        },
        "chakra": {
          "type": "string",
          "const": "#3DCEA8"
        },
        "olive": {
          "type": "string",
          "const": "#1A6B58"
        },
        "off": {
          "type": "string",
          "const": "#D7F5EC"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateLocked"
      ],
      "properties": {
        "immediateLocked": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "acceptance": [
    "Needle must settle within lock threshold ±0.08 and hold lockHoldMs 380",
    "Auto-run applies frozen wobble amplitude 0.035 while seeking centre",
    "Resolved latches LOCKED with lock pulse 150ms",
    "Replay restores unbalanced needle before rerunning",
    "Reduced motion shows LOCKED immediately"
  ]
}
