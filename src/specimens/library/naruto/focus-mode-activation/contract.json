{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/focus-mode-activation.schema.json",
  "title": "FocusModeActivation",
  "description": "Corner brackets converge to a frozen inset on host content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "bracketInsetPx",
    "narrowMs",
    "settleMs",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "focus-mode-activation"
    },
    "bracketInsetPx": {
      "type": "number",
      "const": 18
    },
    "narrowMs": {
      "type": "number",
      "const": 240
    },
    "settleMs": {
      "type": "number",
      "const": 140
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#070B0E"
        },
        "parchment": {
          "type": "string",
          "const": "#C8E8DC"
        },
        "chakra": {
          "type": "string",
          "const": "#3DCEA8"
        },
        "olive": {
          "type": "string",
          "const": "#1A6B58"
        },
        "off": {
          "type": "string",
          "const": "#D7F5EC"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateFocused"
      ],
      "properties": {
        "immediateFocused": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "acceptance": [
    "Four corner brackets converge to frozen inset 18px over narrowMs 240",
    "Focus mode latches FOCUSED without continuous loop",
    "Preview uses relative+overflow scaffold host",
    "Replay restores NORMAL before rerunning",
    "Reduced motion shows FOCUSED immediately"
  ]
}
