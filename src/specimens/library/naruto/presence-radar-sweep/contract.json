{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/presence-radar-sweep.schema.json",
  "title": "PresenceRadarSweep",
  "description": "A finite radial sweep arcs once across a radar screen, logging three fixed presence blips as it crosses them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "blipCount", "stepMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "presence-radar-sweep" },
    "blipCount": { "type": "number", "const": 3 },
    "stepMs": { "type": "number", "const": 190 },
    "settleMs": { "type": "number", "const": 110 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alert", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#070B0E" },
        "parchment": { "type": "string", "const": "#C8E8DC" },
        "chakra": { "type": "string", "const": "#3DCEA8" },
        "alert": { "type": "string", "const": "#3DCEA8" },
        "olive": { "type": "string", "const": "#1A6B58" },
        "off": { "type": "string", "const": "#D7F5EC" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateComplete"],
      "properties": {
        "immediateComplete": { "type": "boolean", "const": true }
      }
    }
  }
}
