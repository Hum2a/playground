{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/presence-radar-sweep.schema.json",
  "title": "PresenceRadarSweep",
  "description": "A finite radial sweep arcs once across a radar screen, logging three fixed presence blips as it crosses them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "blipCount",
    "blips",
    "stepMs",
    "settleMs",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "presence-radar-sweep"
    },
    "blipCount": {
      "type": "number",
      "const": 3
    },
    "blips": {
      "type": "array",
      "const": [
        {
          "cx": 57.6,
          "cy": 49.3,
          "bearingDeg": 42
        },
        {
          "cx": 111.5,
          "cy": 35,
          "bearingDeg": 90
        },
        {
          "cx": 154.1,
          "cy": 62.1,
          "bearingDeg": 138
        }
      ]
    },
    "stepMs": {
      "type": "number",
      "const": 190
    },
    "settleMs": {
      "type": "number",
      "const": 110
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "alert",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#070B0E"
        },
        "parchment": {
          "type": "string",
          "const": "#C8E8DC"
        },
        "chakra": {
          "type": "string",
          "const": "#3DCEA8"
        },
        "alert": {
          "type": "string",
          "const": "#3DCEA8"
        },
        "olive": {
          "type": "string",
          "const": "#1A6B58"
        },
        "off": {
          "type": "string",
          "const": "#D7F5EC"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateComplete"
      ],
      "properties": {
        "immediateComplete": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "anglesDeg": {
      "type": "array",
      "const": [
        -40,
        10,
        55
      ]
    }
  }
}
