{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/circular-seal-lock.schema.json",
  "title": "CircularSealLock",
  "description": "A ring of radial marks rotates into alignment with fixed index marks and locks with a settling pulse.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "rotateMs", "initialOffsetDeg", "lockPulseMs", "markCount", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "circular-seal-lock" },
    "rotateMs": { "type": "number", "const": 520 },
    "initialOffsetDeg": { "type": "number", "const": -42 },
    "lockPulseMs": { "type": "number", "const": 150 },
    "markCount": { "type": "number", "const": 6 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateLocked"],
      "properties": {
        "immediateLocked": { "type": "boolean", "const": true }
      }
    }
  }
}
