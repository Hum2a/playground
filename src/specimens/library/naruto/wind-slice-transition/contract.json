{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/wind-slice-transition.schema.json",
  "title": "WindSliceTransition",
  "description": "Staggered diagonal blades sweep across the stage, exchanging content mid-sweep.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "bladeCount", "bladeMs", "staggerMs", "swapAtMs", "totalMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "wind-slice-transition" },
    "bladeCount": { "type": "number", "const": 4 },
    "bladeMs": { "type": "number", "const": 380 },
    "staggerMs": { "type": "number", "const": 70 },
    "swapAtMs": { "type": "number", "const": 420 },
    "totalMs": { "type": "number", "const": 600 },
    "settleMs": { "type": "number", "const": 150 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#0C1014" },
        "parchment": { "type": "string", "const": "#D0D6DC" },
        "chakra": { "type": "string", "const": "#8AA0B4" },
        "olive": { "type": "string", "const": "#5A6870" },
        "off": { "type": "string", "const": "#EEF2F4" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateSwap"],
      "properties": {
        "immediateSwap": { "type": "boolean", "const": true }
      }
    }
  }
}
