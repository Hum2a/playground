{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/error-substitution-recovery.schema.json",
  "title": "ErrorSubstitutionRecovery",
  "description": "Primary fault triggers decoy substitution then recovers onto the fallback service.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "faultMs", "subMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "error-substitution-recovery" },
    "faultMs": { "type": "number", "const": 170 },
    "subMs": { "type": "number", "const": 100 },
    "settleMs": { "type": "number", "const": 90 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "ash", "danger", "mute", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#12141A" },
        "parchment": { "type": "string", "const": "#D8D4E0" },
        "ash": { "type": "string", "const": "#7A6B9A" },
        "danger": { "type": "string", "const": "#A85868" },
        "mute": { "type": "string", "const": "#6E6A78" },
        "off": { "type": "string", "const": "#F0EEF4" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateRecovered"],
      "properties": {
        "immediateRecovered": { "type": "boolean", "const": true }
      }
    }
  }
}
