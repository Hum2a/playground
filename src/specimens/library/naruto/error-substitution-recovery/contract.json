{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/error-substitution-recovery.schema.json",
  "title": "ErrorSubstitutionRecovery",
  "description": "A primary service fault triggers rapid decoy substitution and settles into a recovered fallback state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "faultMs", "substituteMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "error-substitution-recovery" },
    "faultMs": { "type": "number", "const": 170 },
    "substituteMs": { "type": "number", "const": 100 },
    "settleMs": { "type": "number", "const": 90 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "danger", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "danger": { "type": "string", "const": "#D94A38" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateRecovered"],
      "properties": {
        "immediateRecovered": { "type": "boolean", "const": true }
      }
    }
  }
}
