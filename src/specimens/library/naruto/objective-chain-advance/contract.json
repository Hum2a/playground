{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/objective-chain-advance.schema.json",
  "title": "ObjectiveChainAdvance",
  "description": "Each completed checkpoint in a four-step chain sends a pulse to activate the next.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "checkpointCount", "completeMs", "pulseMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "objective-chain-advance" },
    "checkpointCount": { "type": "number", "const": 4 },
    "completeMs": { "type": "number", "const": 200 },
    "pulseMs": { "type": "number", "const": 220 },
    "settleMs": { "type": "number", "const": 100 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alert", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#1A1612" },
        "parchment": { "type": "string", "const": "#EBE2D0" },
        "chakra": { "type": "string", "const": "#B83228" },
        "alert": { "type": "string", "const": "#B83228" },
        "olive": { "type": "string", "const": "#6A5E4E" },
        "off": { "type": "string", "const": "#F7F2E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateClear"],
      "properties": {
        "immediateClear": { "type": "boolean", "const": true }
      }
    }
  }
}
