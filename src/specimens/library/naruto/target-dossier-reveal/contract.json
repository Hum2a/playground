{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/target-dossier-reveal.schema.json",
  "title": "TargetDossierReveal",
  "description": "A restricted dossier peels its redaction layer and breaks its seal to reveal target intel.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "peelMs", "revealMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "target-dossier-reveal" },
    "peelMs": { "type": "number", "const": 260 },
    "revealMs": { "type": "number", "const": 220 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alarm", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "alarm": { "type": "string", "const": "#D94A38" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateRevealed"],
      "properties": {
        "immediateRevealed": { "type": "boolean", "const": true }
      }
    }
  }
}
