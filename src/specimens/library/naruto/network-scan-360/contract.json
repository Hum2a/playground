{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/network-scan-360.schema.json",
  "title": "NetworkScan360",
  "description": "A radial sweep rotates a full circle from a central hub, wiring in five connected nodes at frozen bearings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "nodeCount", "anglesDeg", "stepMs", "settleMs", "closeDeg", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "network-scan-360" },
    "nodeCount": { "type": "number", "const": 5 },
    "anglesDeg": { "type": "array", "const": [0, 72, 144, 216, 288] },
    "stepMs": { "type": "number", "const": 150 },
    "settleMs": { "type": "number", "const": 100 },
    "closeDeg": { "type": "number", "const": 330 },
    "radiusPx": { "type": "number", "const": 52 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "phosphor", "phosphorDim", "off", "mute"],
      "properties": {
        "ink": { "type": "string", "const": "#070B0E" },
        "phosphor": { "type": "string", "const": "#3DCEA8" },
        "phosphorDim": { "type": "string", "const": "#1A6B58" },
        "off": { "type": "string", "const": "#D7F5EC" },
        "mute": { "type": "string", "const": "#6A9A8C" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateMapped"],
      "properties": {
        "immediateMapped": { "type": "boolean", "const": true }
      }
    }
  }
}
