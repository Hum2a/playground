{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/network-scan-360.schema.json",
  "title": "NetworkScan360",
  "description": "360° sweep discovers five nodes at frozen bearings with a discovery log.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "nodeCount",
    "anglesDeg",
    "stepMs",
    "settleMs",
    "closeDeg",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "network-scan-360"
    },
    "nodeCount": {
      "type": "number",
      "const": 5
    },
    "anglesDeg": {
      "type": "array",
      "const": [
        0,
        72,
        144,
        216,
        288
      ]
    },
    "stepMs": {
      "type": "number",
      "const": 160
    },
    "settleMs": {
      "type": "number",
      "const": 100
    },
    "closeDeg": {
      "type": "number",
      "const": 360
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#070B0E"
        },
        "parchment": {
          "type": "string",
          "const": "#C8E8DC"
        },
        "chakra": {
          "type": "string",
          "const": "#3DCEA8"
        },
        "olive": {
          "type": "string",
          "const": "#1A6B58"
        },
        "off": {
          "type": "string",
          "const": "#D7F5EC"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateInventory"
      ],
      "properties": {
        "immediateInventory": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
