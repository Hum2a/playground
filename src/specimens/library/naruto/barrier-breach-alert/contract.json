{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/barrier-breach-alert.schema.json",
  "title": "BarrierBreachAlert",
  "description": "Single fracture + alert latch; no loop flash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "fractureDeg",
    "fractureCount",
    "alarmMs",
    "noLoopFlash",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "barrier-breach-alert"
    },
    "fractureDeg": {
      "type": "number",
      "const": -18
    },
    "fractureCount": {
      "type": "number",
      "const": 1
    },
    "alarmMs": {
      "type": "number",
      "const": 280
    },
    "settleMs": {
      "type": "number",
      "const": 60
    },
    "noLoopFlash": {
      "type": "boolean",
      "const": true
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "alert",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#0C0806"
        },
        "parchment": {
          "type": "string",
          "const": "#C4B8A8"
        },
        "chakra": {
          "type": "string",
          "const": "#C43C2E"
        },
        "alert": {
          "type": "string",
          "const": "#D94A38"
        },
        "olive": {
          "type": "string",
          "const": "#5A5048"
        },
        "off": {
          "type": "string",
          "const": "#F4F1E8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateBreached"
      ],
      "properties": {
        "immediateBreached": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "acceptance": [
    "Single fracture at frozen angle -18° (fractureCount 1)",
    "One alarm pulse 280ms then BREACH DETECTED latches (no loop flash)",
    "Seal lacquer palette",
    "Replay restores SECURE before rerunning",
    "Reduced motion shows BREACH DETECTED immediately"
  ]
}
