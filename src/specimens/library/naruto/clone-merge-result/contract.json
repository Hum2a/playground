{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/clone-merge-result.schema.json",
  "title": "CloneMergeResult",
  "description": "Three parallel clone result cards converge and combine into a single output card.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "values", "mergedValue", "convergeMs", "mergeMs", "expandMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "clone-merge-result" },
    "values": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3,
      "const": [7, 4, 9]
    },
    "mergedValue": { "type": "number", "const": 20 },
    "convergeMs": { "type": "number", "const": 220 },
    "mergeMs": { "type": "number", "const": 100 },
    "expandMs": { "type": "number", "const": 140 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#12141A" },
        "parchment": { "type": "string", "const": "#D8D4E0" },
        "chakra": { "type": "string", "const": "#7A6B9A" },
        "olive": { "type": "string", "const": "#6E6A78" },
        "off": { "type": "string", "const": "#F0EEF4" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateMerged"],
      "properties": {
        "immediateMerged": { "type": "boolean", "const": true }
      }
    }
  }
}
