{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/technique-mastery-tree.schema.json",
  "title": "TechniqueMasteryTree",
  "description": "Four skill nodes unlock one-by-one along a branching path, filling the connecting path into a resolved MASTERED state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "nodeCount", "stepMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "technique-mastery-tree" },
    "nodeCount": { "type": "number", "const": 4 },
    "stepMs": { "type": "number", "const": 150 },
    "settleMs": { "type": "number", "const": 100 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alarm", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "alarm": { "type": "string", "const": "#D94A38" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateMastered"],
      "properties": {
        "immediateMastered": { "type": "boolean", "const": true }
      }
    }
  }
}
