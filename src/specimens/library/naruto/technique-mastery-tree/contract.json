{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/technique-mastery-tree.schema.json",
  "title": "TechniqueMasteryTree",
  "description": "Four technique nodes unlock in order with edge draw between them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "nodeCount",
    "nodeIds",
    "stepMs",
    "edgeDrawMs",
    "settleMs",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "technique-mastery-tree"
    },
    "nodeCount": {
      "type": "number",
      "const": 4
    },
    "nodeIds": {
      "type": "array",
      "const": [
        "n1",
        "n2",
        "n3",
        "n4"
      ]
    },
    "stepMs": {
      "type": "number",
      "const": 150
    },
    "edgeDrawMs": {
      "type": "number",
      "const": 150
    },
    "settleMs": {
      "type": "number",
      "const": 100
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#1A1612"
        },
        "parchment": {
          "type": "string",
          "const": "#EBE2D0"
        },
        "chakra": {
          "type": "string",
          "const": "#B83228"
        },
        "olive": {
          "type": "string",
          "const": "#6A5E4E"
        },
        "off": {
          "type": "string",
          "const": "#F7F2E8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateMastered"
      ],
      "properties": {
        "immediateMastered": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
