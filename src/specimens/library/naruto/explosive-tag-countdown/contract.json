{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/explosive-tag-countdown.schema.json",
  "title": "ExplosiveTagCountdown",
  "description": "Warning tag arms, counts 3-2-1 with rising intensity, detonates, CLEAR hold.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "armMs",
    "stepMs",
    "burstMs",
    "settleMs",
    "clearHoldMs",
    "digits",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "explosive-tag-countdown"
    },
    "armMs": {
      "type": "number",
      "const": 220
    },
    "stepMs": {
      "type": "number",
      "const": 480
    },
    "burstMs": {
      "type": "number",
      "const": 240
    },
    "settleMs": {
      "type": "number",
      "const": 200
    },
    "clearHoldMs": {
      "type": "number",
      "const": 220
    },
    "digits": {
      "type": "array",
      "const": [
        3,
        2,
        1
      ]
    },
    "pulseMsByLevel": {
      "type": "object",
      "const": {
        "1": 220,
        "2": 340,
        "3": 480
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "ember",
        "danger",
        "soot",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#0C0806"
        },
        "parchment": {
          "type": "string",
          "const": "#C4B8A8"
        },
        "ember": {
          "type": "string",
          "const": "#E07030"
        },
        "danger": {
          "type": "string",
          "const": "#D94A38"
        },
        "soot": {
          "type": "string",
          "const": "#5A5048"
        },
        "off": {
          "type": "string",
          "const": "#F4F1E8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateClear"
      ],
      "properties": {
        "immediateClear": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "acceptance": [
    "Arm 220ms then count 3→2→1 with rising pulse intensity (480/340/220ms)",
    "Burst 240ms then CLEAR with clearHoldMs 220",
    "Intensity escalation via pulse duration, not opacity-only flash",
    "Replay restores IDLE before rerunning",
    "Reduced motion shows CLEAR immediately"
  ]
}
