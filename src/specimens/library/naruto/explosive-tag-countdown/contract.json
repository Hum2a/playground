{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/explosive-tag-countdown.schema.json",
  "title": "ExplosiveTagCountdown",
  "description": "Warning tag arms, counts 3-2-1 through rising-intensity pulses, detonates, and settles cleared.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "armMs", "stepMs", "burstMs", "settleMs", "digits", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "explosive-tag-countdown" },
    "armMs": { "type": "number", "const": 220 },
    "stepMs": { "type": "number", "const": 480 },
    "burstMs": { "type": "number", "const": 240 },
    "settleMs": { "type": "number", "const": 200 },
    "digits": { "type": "array", "const": [3, 2, 1] },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "ember", "danger", "soot", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#0C0806" },
        "parchment": { "type": "string", "const": "#C4B8A8" },
        "ember": { "type": "string", "const": "#E07030" },
        "danger": { "type": "string", "const": "#D94A38" },
        "soot": { "type": "string", "const": "#5A5048" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateClear"],
      "properties": {
        "immediateClear": { "type": "boolean", "const": true }
      }
    }
  }
}
