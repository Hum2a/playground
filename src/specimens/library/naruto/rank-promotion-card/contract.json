{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/rank-promotion-card.schema.json",
  "title": "RankPromotionCard",
  "description": "Profile badge morphs GENIN→CHUNIN via collapse → expand → glow phases.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "fromRank",
    "toRank",
    "collapseMs",
    "expandMs",
    "glowMs",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "rank-promotion-card"
    },
    "fromRank": {
      "type": "string",
      "const": "GENIN"
    },
    "toRank": {
      "type": "string",
      "const": "CHUNIN"
    },
    "collapseMs": {
      "type": "number",
      "const": 140
    },
    "expandMs": {
      "type": "number",
      "const": 180
    },
    "glowMs": {
      "type": "number",
      "const": 280
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "alarm",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#1A1612"
        },
        "parchment": {
          "type": "string",
          "const": "#EBE2D0"
        },
        "chakra": {
          "type": "string",
          "const": "#B83228"
        },
        "alarm": {
          "type": "string",
          "const": "#B83228"
        },
        "olive": {
          "type": "string",
          "const": "#6A5E4E"
        },
        "off": {
          "type": "string",
          "const": "#F7F2E8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediatePromoted"
      ],
      "properties": {
        "immediatePromoted": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
