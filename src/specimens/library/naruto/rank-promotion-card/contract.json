{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/rank-promotion-card.schema.json",
  "title": "RankPromotionCard",
  "description": "A profile card flips from its current rank badge into the promoted rank with a settling glow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "foldMs", "glowMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "rank-promotion-card" },
    "foldMs": { "type": "number", "const": 260 },
    "glowMs": { "type": "number", "const": 320 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alarm", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#1A1612" },
        "parchment": { "type": "string", "const": "#EBE2D0" },
        "chakra": { "type": "string", "const": "#B83228" },
        "alarm": { "type": "string", "const": "#B83228" },
        "olive": { "type": "string", "const": "#6A5E4E" },
        "off": { "type": "string", "const": "#F7F2E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediatePromoted"],
      "properties": {
        "immediatePromoted": { "type": "boolean", "const": true }
      }
    }
  }
}
