{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/three-person-cell-formation.schema.json",
  "title": "ThreePersonCellFormation",
  "description": "Three nodes snap to frozen triangle positions then draw links.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "nodeCount",
    "snapMs",
    "linkMs",
    "formedPositions",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "three-person-cell-formation"
    },
    "nodeCount": {
      "type": "number",
      "const": 3
    },
    "snapMs": {
      "type": "number",
      "const": 260
    },
    "linkMs": {
      "type": "number",
      "const": 180
    },
    "formedPositions": {
      "type": "object",
      "const": {
        "lead": {
          "top": "14%",
          "left": "50%"
        },
        "scout": {
          "top": "78%",
          "left": "24%"
        },
        "support": {
          "top": "78%",
          "left": "76%"
        }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "alarm",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#1A1612"
        },
        "parchment": {
          "type": "string",
          "const": "#EBE2D0"
        },
        "chakra": {
          "type": "string",
          "const": "#B83228"
        },
        "alarm": {
          "type": "string",
          "const": "#B83228"
        },
        "olive": {
          "type": "string",
          "const": "#6A5E4E"
        },
        "off": {
          "type": "string",
          "const": "#F7F2E8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateFormed"
      ],
      "properties": {
        "immediateFormed": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
