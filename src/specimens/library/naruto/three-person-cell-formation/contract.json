{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/three-person-cell-formation.schema.json",
  "title": "ThreePersonCellFormation",
  "description": "Three scattered profile nodes snap into a triangular cell and their connecting lines light to link them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "nodeCount", "snapMs", "linkMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "three-person-cell-formation" },
    "nodeCount": { "type": "number", "const": 3 },
    "snapMs": { "type": "number", "const": 260 },
    "linkMs": { "type": "number", "const": 200 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alarm", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "alarm": { "type": "string", "const": "#D94A38" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateFormed"],
      "properties": {
        "immediateFormed": { "type": "boolean", "const": true }
      }
    }
  }
}
