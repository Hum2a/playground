{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/summoning-seal-materialise.schema.json",
  "title": "SummoningSealMaterialise",
  "description": "A radial seal draws itself, then a panel rises out of its centre and settles into place.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "ringOuterMs", "ringInnerMs", "panelMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "summoning-seal-materialise" },
    "ringOuterMs": { "type": "number", "const": 300 },
    "ringInnerMs": { "type": "number", "const": 260 },
    "panelMs": { "type": "number", "const": 300 },
    "settleMs": { "type": "number", "const": 100 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alert", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#140C0C" },
        "parchment": { "type": "string", "const": "#E8DCC8" },
        "chakra": { "type": "string", "const": "#C43C2E" },
        "alert": { "type": "string", "const": "#C43C2E" },
        "olive": { "type": "string", "const": "#6B5048" },
        "off": { "type": "string", "const": "#F3EBE0" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateMaterialised"],
      "properties": {
        "immediateMaterialised": { "type": "boolean", "const": true }
      }
    }
  }
}
