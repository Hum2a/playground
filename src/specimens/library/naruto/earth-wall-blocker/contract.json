{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/earth-wall-blocker.schema.json",
  "title": "EarthWallBlocker",
  "description": "Five segmented slabs rise staggered from below to form a protective wall.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slabCount", "slabMs", "staggerMs", "riseTotalMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "earth-wall-blocker" },
    "slabCount": { "type": "number", "const": 5 },
    "slabMs": { "type": "number", "const": 280 },
    "staggerMs": { "type": "number", "const": 55 },
    "riseTotalMs": { "type": "number", "const": 500 },
    "settleMs": { "type": "number", "const": 150 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateRaise"],
      "properties": {
        "immediateRaise": { "type": "boolean", "const": true }
      }
    }
  }
}
