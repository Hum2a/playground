{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/high-speed-card-relocation.schema.json",
  "title": "HighSpeedCardRelocation",
  "description": "A selected card leaves exactly two fading afterimages as it relocates at speed into a second container slot.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "ghostCount", "travelMs", "ghostLifeMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "high-speed-card-relocation" },
    "ghostCount": { "type": "number", "const": 2 },
    "travelMs": { "type": "number", "const": 200 },
    "ghostLifeMs": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "const": [220, 150]
    },
    "settleMs": { "type": "number", "const": 40 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#0C1014" },
        "parchment": { "type": "string", "const": "#D0D6DC" },
        "chakra": { "type": "string", "const": "#8AA0B4" },
        "olive": { "type": "string", "const": "#5A6870" },
        "off": { "type": "string", "const": "#EEF2F4" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateArrival"],
      "properties": {
        "immediateArrival": { "type": "boolean", "const": true }
      }
    }
  }
}
