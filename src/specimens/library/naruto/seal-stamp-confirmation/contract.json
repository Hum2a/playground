{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/seal-stamp-confirmation.schema.json",
  "title": "SealStampConfirmation",
  "description": "A stamp strikes a document once, then an ink seal mark blooms into view as confirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "descentMs", "impactMs", "inkBloomMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "seal-stamp-confirmation" },
    "descentMs": { "type": "number", "const": 220 },
    "impactMs": { "type": "number", "const": 90 },
    "inkBloomMs": { "type": "number", "const": 200 },
    "settleMs": { "type": "number", "const": 90 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alert", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#140C0C" },
        "parchment": { "type": "string", "const": "#E8DCC8" },
        "chakra": { "type": "string", "const": "#C43C2E" },
        "alert": { "type": "string", "const": "#C43C2E" },
        "olive": { "type": "string", "const": "#6B5048" },
        "off": { "type": "string", "const": "#F3EBE0" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateFiled"],
      "properties": {
        "immediateFiled": { "type": "boolean", "const": true }
      }
    }
  }
}
