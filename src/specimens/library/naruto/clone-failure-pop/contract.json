{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/clone-failure-pop.schema.json",
  "title": "CloneFailurePop",
  "description": "One of three parallel worker clones pops and collapses mid-run while the remaining clones continue to completion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "workerCount", "failIndex", "failAtMs", "finishMs", "settleMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "clone-failure-pop" },
    "workerCount": { "type": "number", "const": 3 },
    "failIndex": { "type": "number", "const": 1 },
    "failAtMs": { "type": "number", "const": 150 },
    "finishMs": { "type": "number", "const": 320 },
    "settleMs": { "type": "number", "const": 80 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "danger", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#12141A" },
        "parchment": { "type": "string", "const": "#D8D4E0" },
        "chakra": { "type": "string", "const": "#7A6B9A" },
        "danger": { "type": "string", "const": "#A85868" },
        "olive": { "type": "string", "const": "#6E6A78" },
        "off": { "type": "string", "const": "#F0EEF4" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateFinalStates"],
      "properties": {
        "immediateFinalStates": { "type": "boolean", "const": true }
      }
    }
  }
}
