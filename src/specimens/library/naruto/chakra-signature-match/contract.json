{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/chakra-signature-match.schema.json",
  "title": "ChakraSignatureMatch",
  "description": "Five signal bars rise to meet a reference profile, resolving to a confirmed match.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "bandCount", "stepMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "chakra-signature-match" },
    "bandCount": { "type": "number", "const": 5 },
    "stepMs": { "type": "number", "const": 170 },
    "settleMs": { "type": "number", "const": 100 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alert", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#070B0E" },
        "parchment": { "type": "string", "const": "#C8E8DC" },
        "chakra": { "type": "string", "const": "#3DCEA8" },
        "alert": { "type": "string", "const": "#3DCEA8" },
        "olive": { "type": "string", "const": "#1A6B58" },
        "off": { "type": "string", "const": "#D7F5EC" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateMatch"],
      "properties": {
        "immediateMatch": { "type": "boolean", "const": true }
      }
    }
  }
}
