{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/versus-clash-card.schema.json",
  "title": "VersusClashCard",
  "description": "Opposing cards slam 28px inward, hold clash, then lock.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "travelPx",
    "closeMs",
    "clashHoldMs",
    "flashMs",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "versus-clash-card"
    },
    "travelPx": {
      "type": "number",
      "const": 28
    },
    "closeMs": {
      "type": "number",
      "const": 240
    },
    "clashHoldMs": {
      "type": "number",
      "const": 180
    },
    "flashMs": {
      "type": "number",
      "const": 200
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "alarm",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#1A1612"
        },
        "parchment": {
          "type": "string",
          "const": "#EBE2D0"
        },
        "chakra": {
          "type": "string",
          "const": "#B83228"
        },
        "alarm": {
          "type": "string",
          "const": "#B83228"
        },
        "olive": {
          "type": "string",
          "const": "#6A5E4E"
        },
        "off": {
          "type": "string",
          "const": "#F7F2E8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateClash"
      ],
      "properties": {
        "immediateClash": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
