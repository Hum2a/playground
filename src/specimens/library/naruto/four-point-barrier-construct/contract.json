{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/four-point-barrier-construct.schema.json",
  "title": "FourPointBarrierConstruct",
  "description": "Corners → edges → fill with frozen corner coords and edge draw ms.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "corners",
    "edgeCount",
    "edgeMs",
    "fillMs",
    "settleMs",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "four-point-barrier-construct"
    },
    "corners": {
      "type": "array",
      "const": [
        {
          "x": 30,
          "y": 30
        },
        {
          "x": 170,
          "y": 30
        },
        {
          "x": 170,
          "y": 170
        },
        {
          "x": 30,
          "y": 170
        }
      ]
    },
    "edgeCount": {
      "type": "number",
      "const": 4
    },
    "edgeMs": {
      "type": "number",
      "const": 160
    },
    "fillMs": {
      "type": "number",
      "const": 180
    },
    "settleMs": {
      "type": "number",
      "const": 90
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "alert",
        "olive",
        "off"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#0C0806"
        },
        "parchment": {
          "type": "string",
          "const": "#C4B8A8"
        },
        "chakra": {
          "type": "string",
          "const": "#C43C2E"
        },
        "alert": {
          "type": "string",
          "const": "#C43C2E"
        },
        "olive": {
          "type": "string",
          "const": "#5A5048"
        },
        "off": {
          "type": "string",
          "const": "#F4F1E8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateSecured"
      ],
      "properties": {
        "immediateSecured": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
