{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/four-point-barrier-construct.schema.json",
  "title": "FourPointBarrierConstruct",
  "description": "Corners → edges → fill barrier construction with frozen coords.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "cornerCoords",
    "edgeCount",
    "cornerMs",
    "edgeMs",
    "fillMs",
    "colours",
    "reducedMotion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "const": "four-point-barrier-construct"
    },
    "cornerCoords": {
      "type": "array",
      "const": [
        {
          "x": 30,
          "y": 30
        },
        {
          "x": 170,
          "y": 30
        },
        {
          "x": 170,
          "y": 170
        },
        {
          "x": 30,
          "y": 170
        }
      ]
    },
    "edgeCount": {
      "type": "number",
      "const": 4
    },
    "cornerMs": {
      "type": "number",
      "const": 90
    },
    "edgeMs": {
      "type": "number",
      "const": 220
    },
    "fillMs": {
      "type": "number",
      "const": 260
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "parchment",
        "chakra",
        "olive",
        "off",
        "alert"
      ],
      "properties": {
        "ink": {
          "type": "string",
          "const": "#070B0E"
        },
        "parchment": {
          "type": "string",
          "const": "#C8E8DC"
        },
        "chakra": {
          "type": "string",
          "const": "#3DCEA8"
        },
        "olive": {
          "type": "string",
          "const": "#1A6B58"
        },
        "off": {
          "type": "string",
          "const": "#D7F5EC"
        },
        "alert": {
          "type": "string",
          "const": "#3DCEA8"
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediateSecure"
      ],
      "properties": {
        "immediateSecure": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
