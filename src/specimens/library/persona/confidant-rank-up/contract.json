{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/confidant-rank-up.schema.json",
  "title": "ConfidantRankUp",
  "description": "Portable visual/component contract for a Persona-inspired bond/rank progression event: flash, ring burst, number swap, banner slam-to-corner-tag. Not a database schema. No copyrighted assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "layout",
    "colours",
    "animation",
    "dom",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "confidant-rank-up" },
    "intent": {
      "type": "string",
      "const": "Bond/rank card takes a flash hit, ring burst, and number swap while a RANK UP banner slams in then shrinks into a permanent corner ribbon tag."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "name", "oldRank", "newRank", "banner"],
      "properties": {
        "eyebrow": { "type": "string", "const": "CONFIDANT" },
        "name": { "type": "string", "const": "Ally" },
        "oldRank": { "type": "string", "const": "6" },
        "newRank": { "type": "string", "const": "7" },
        "banner": { "type": "string", "const": "RANK UP" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardWidth", "badgeSizePx", "ringCount"],
      "properties": {
        "cardWidth": { "type": "string", "const": "min(88%, 240px)" },
        "badgeSizePx": { "type": "number", "const": 52 },
        "ringCount": { "type": "integer", "const": 3 }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "paper", "accent"],
      "properties": {
        "ink": { "type": "string", "const": "#0d0d0d" },
        "paper": { "type": "string", "const": "#f2eee3" },
        "accent": { "type": "string", "const": "#d71920" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flash", "rings", "oldNumberOut", "newNumberIn", "banner"],
      "properties": {
        "flash": {
          "type": "object",
          "required": ["name", "durationMs"],
          "properties": {
            "name": { "type": "string", "const": "rank-up-flash" },
            "durationMs": { "type": "number", "const": 260 }
          }
        },
        "rings": {
          "type": "object",
          "required": ["name", "durationMs", "staggerMsList"],
          "properties": {
            "name": { "type": "string", "const": "rank-up-ring" },
            "durationMs": { "type": "number", "const": 420 },
            "staggerMsList": { "type": "array", "const": [80, 150, 220] }
          }
        },
        "oldNumberOut": {
          "type": "object",
          "required": ["name", "durationMs", "delayMs"],
          "properties": {
            "name": { "type": "string", "const": "rank-up-old-out" },
            "durationMs": { "type": "number", "const": 260 },
            "delayMs": { "type": "number", "const": 200 }
          }
        },
        "newNumberIn": {
          "type": "object",
          "required": ["name", "durationMs", "delayMs", "timingFunction"],
          "properties": {
            "name": { "type": "string", "const": "rank-up-new-in" },
            "durationMs": { "type": "number", "const": 260 },
            "delayMs": { "type": "number", "const": 330 },
            "timingFunction": { "type": "string", "const": "cubic-bezier(0.2, 0.85, 0.25, 1.3)" }
          }
        },
        "banner": {
          "type": "object",
          "required": ["name", "durationMs", "delayMs", "timingFunction", "keyframes"],
          "properties": {
            "name": { "type": "string", "const": "rank-up-banner-slam" },
            "durationMs": { "type": "number", "const": 640 },
            "delayMs": { "type": "number", "const": 60 },
            "timingFunction": { "type": "string", "const": "cubic-bezier(0.18, 0.85, 0.2, 1.1)" },
            "keyframes": {
              "type": "object",
              "required": ["from", "impact", "recoil", "to"],
              "properties": {
                "from": { "type": "object", "const": { "rotate": "-14deg", "scale": 1.3, "opacity": 0 } },
                "impact": { "type": "object", "const": { "atPercent": 46, "rotate": "-4deg", "scale": 1.08, "opacity": 1 } },
                "recoil": { "type": "object", "const": { "atPercent": 62, "rotate": "-6deg", "scale": 1 } },
                "to": {
                  "type": "object",
                  "const": {
                    "relocatePx": { "x": 52, "y": -58 },
                    "rotate": "-8deg",
                    "scale": 0.5,
                    "opacity": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "dom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "children"],
      "properties": {
        "root": {
          "type": "object",
          "required": ["tag", "className", "dataAttr"],
          "properties": {
            "tag": { "type": "string", "const": "div" },
            "className": { "type": "string", "const": "rank-up" },
            "dataAttr": { "type": "string", "const": "data-rank-up" }
          }
        },
        "children": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["role", "className"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["card", "avatar", "eyebrow", "name", "badge", "rings", "ring", "numberOld", "numberNew", "banner", "flash", "replay"]
              },
              "className": { "type": "string" },
              "ariaHidden": { "type": "boolean" }
            }
          }
        }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ringsFlashBannerDecorative", "numberIsRealText", "doNotRelyOnMotionAlone"],
      "properties": {
        "ringsFlashBannerDecorative": { "type": "boolean", "const": true },
        "numberIsRealText": { "type": "boolean", "const": true },
        "doNotRelyOnMotionAlone": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["showStaticSettled", "triggers"],
      "properties": {
        "showStaticSettled": {
          "type": "boolean",
          "const": true,
          "description": "Skip flash/rings/swap/slam; show new number and corner-tag banner immediately."
        },
        "triggers": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "enum": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"] }
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "card", "badge", "numberOld", "numberNew", "banner", "flash", "replay", "stateEnter", "stateSettled", "stateReset"],
      "properties": {
        "root": { "type": "string", "const": "rank-up" },
        "card": { "type": "string", "const": "rank-up__card" },
        "badge": { "type": "string", "const": "rank-up__badge" },
        "numberOld": { "type": "string", "const": "rank-up__number--old" },
        "numberNew": { "type": "string", "const": "rank-up__number--new" },
        "banner": { "type": "string", "const": "rank-up__banner" },
        "flash": { "type": "string", "const": "rank-up__flash" },
        "replay": { "type": "string", "const": "rank-up-replay" },
        "stateEnter": { "type": "string", "const": "rank-up--enter" },
        "stateSettled": { "type": "string", "const": "rank-up--settled" },
        "stateReset": { "type": "string", "const": "rank-up--reset" }
      }
    }
  }
}
