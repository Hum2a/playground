{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/overlapping-newspaper-tabs.schema.json",
  "title": "OverlappingNewspaperTabs",
  "description": "Portable visual/component contract for a Persona-inspired tablist where torn-edge clippings overlap and the active tab climbs above the stack. Not a database schema. No copyrighted assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "layout",
    "colours",
    "animation",
    "dom",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "overlapping-newspaper-tabs" },
    "intent": {
      "type": "string",
      "const": "Torn-edge clipping tabs overlap at fixed rotations; the selected tab climbs above the stack and straightens while others stay tilted underneath."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabs"],
      "properties": {
        "tabs": {
          "type": "array",
          "const": [
            { "kicker": "01", "label": "FRONT PAGE", "panel": "Now viewing: Front Page" },
            { "kicker": "02", "label": "SPORTS", "panel": "Now viewing: Sports" },
            { "kicker": "03", "label": "OPINION", "panel": "Now viewing: Opinion" },
            { "kicker": "04", "label": "CLASSIFIED", "panel": "Now viewing: Classified" }
          ]
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlapPx", "rotationsDegrees", "activeLift"],
      "properties": {
        "overlapPx": { "type": "number", "const": -12 },
        "rotationsDegrees": { "type": "array", "const": [-3, 2, -2, 3] },
        "activeLift": {
          "type": "object",
          "required": ["translateYPx", "scale"],
          "properties": {
            "translateYPx": { "type": "number", "const": -8 },
            "scale": { "type": "number", "const": 1.06 }
          }
        }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "paper", "accent"],
      "properties": {
        "ink": { "type": "string", "const": "#0d0d0d" },
        "paper": { "type": "string", "const": "#f2eee3" },
        "accent": { "type": "string", "const": "#d71920" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabTransition", "panelTransition", "activeBackingShadow"],
      "properties": {
        "tabTransition": {
          "type": "object",
          "required": ["transformDurationMs", "transformTimingFunction", "colourDurationMs"],
          "properties": {
            "transformDurationMs": { "type": "number", "const": 260 },
            "transformTimingFunction": { "type": "string", "const": "cubic-bezier(0.22, 0.85, 0.2, 1.15)" },
            "colourDurationMs": { "type": "number", "const": 200 }
          }
        },
        "panelTransition": {
          "type": "object",
          "required": ["durationMs"],
          "properties": {
            "durationMs": { "type": "number", "const": 160 }
          }
        },
        "activeBackingShadow": { "type": "string", "const": "4px 4px 0 #0d0d0d" }
      }
    },
    "dom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "children"],
      "properties": {
        "root": {
          "type": "object",
          "required": ["tag", "className", "dataAttr"],
          "properties": {
            "tag": { "type": "string", "const": "div" },
            "className": { "type": "string", "const": "newspaper-tabs" },
            "dataAttr": { "type": "string", "const": "data-newspaper-tabs" }
          }
        },
        "children": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["role", "className"],
            "properties": {
              "role": { "type": "string", "enum": ["tablist", "tab", "kicker", "label", "panels", "panel"] },
              "className": { "type": "string" },
              "ariaRole": { "type": "string" }
            }
          }
        }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apgTabsPattern", "rovingTabindex", "arrowKeyNavigation"],
      "properties": {
        "apgTabsPattern": {
          "type": "boolean",
          "const": true,
          "description": "role=tablist/tab/tabpanel, aria-selected, aria-controls/aria-labelledby."
        },
        "rovingTabindex": { "type": "boolean", "const": true },
        "arrowKeyNavigation": {
          "type": "boolean",
          "const": true,
          "description": "ArrowLeft/ArrowRight/Home/End move focus and selection together."
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dropTransformFromTransition", "keepColourAndOpacityTransition", "triggers"],
      "properties": {
        "dropTransformFromTransition": {
          "type": "boolean",
          "const": true,
          "description": "Tab lift/scale/rotate and panel translateY apply instantly."
        },
        "keepColourAndOpacityTransition": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "enum": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"] }
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "list", "tab", "kicker", "label", "panels", "panel", "panelActive"],
      "properties": {
        "root": { "type": "string", "const": "newspaper-tabs" },
        "list": { "type": "string", "const": "newspaper-tabs__list" },
        "tab": { "type": "string", "const": "newspaper-tabs__tab" },
        "kicker": { "type": "string", "const": "newspaper-tabs__kicker" },
        "label": { "type": "string", "const": "newspaper-tabs__label" },
        "panels": { "type": "string", "const": "newspaper-tabs__panels" },
        "panel": { "type": "string", "const": "newspaper-tabs__panel" },
        "panelActive": { "type": "string", "const": "newspaper-tabs__panel--active" }
      }
    }
  }
}
