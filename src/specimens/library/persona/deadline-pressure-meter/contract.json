{
  "name": "deadline-pressure-meter",
  "intent": "Days remaining compress visually as a deadline approaches.",
  "catalogue": { "p4": "P4-103", "ref": "SPX-3021" },
  "colours": {
    "yellow": "#F5C400",
    "ink": "#101010",
    "paper": "#F7F3E8",
    "muted": "#E8E8E8"
  },
  "steps": [
    { "days": 14, "compress": 1, "markerPercent": 8 },
    { "days": 7, "compress": 0.7, "markerPercent": 20 },
    { "days": 3, "compress": 0.45, "markerPercent": 32 },
    { "days": 1, "compress": 0.35, "markerPercent": 42 }
  ],
  "timing": { "stepMs": 500 },
  "api": { "run": "runDeadlinePressure()", "reset": "resetDeadlinePressure()" },
  "reducedMotion": { "behaviour": "Meter holds at final 1-day compressed state" }
}
