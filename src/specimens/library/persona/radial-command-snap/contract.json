{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/radial-command-snap.schema.json",
  "title": "RadialCommandSnap",
  "description": "Portable visual/component contract for a Persona-inspired radial command wheel where the whole ring snaps a selected option to a fixed top pointer. Not a database schema. No copyrighted assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "layout",
    "colours",
    "animation",
    "dom",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "radial-command-snap" },
    "intent": {
      "type": "string",
      "const": "Five commands on a ring; selecting one snaps the whole arrangement so the choice lands at a fixed top pointer while every label stays upright."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["options"],
      "properties": {
        "options": {
          "type": "array",
          "const": ["ATTACK", "GUARD", "ITEM", "SKILL", "RUN"]
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldDiameterPx", "optionSizePx", "orbitRadiusPx", "slotAnglesDegrees"],
      "properties": {
        "fieldDiameterPx": { "type": "number", "const": 224 },
        "optionSizePx": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "const": 64 },
            "height": { "type": "number", "const": 30 }
          }
        },
        "orbitRadiusPx": { "type": "number", "const": 92 },
        "slotAnglesDegrees": { "type": "array", "const": [0, 72, 144, 216, 288] }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "paper", "accent"],
      "properties": {
        "ink": { "type": "string", "const": "#0d0d0d" },
        "paper": { "type": "string", "const": "#f2eee3" },
        "accent": { "type": "string", "const": "#d71920" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snap", "hubPunch", "autoStepMs", "positionFormula"],
      "properties": {
        "snap": {
          "type": "object",
          "required": ["durationMs", "timingFunction"],
          "properties": {
            "durationMs": { "type": "number", "const": 420 },
            "timingFunction": { "type": "string", "const": "cubic-bezier(0.2, 0.9, 0.15, 1.15)" }
          }
        },
        "hubPunch": {
          "type": "object",
          "required": ["name", "durationMs", "timingFunction"],
          "properties": {
            "name": { "type": "string", "const": "radial-command-hub-punch" },
            "durationMs": { "type": "number", "const": 200 },
            "timingFunction": { "type": "string", "const": "cubic-bezier(0.2, 0.85, 0.25, 1.2)" }
          }
        },
        "autoStepMs": { "type": "number", "const": 620 },
        "positionFormula": {
          "type": "string",
          "const": "rotate(slotAngle - activeSlotAngle) translateY(-92px) rotate(-(slotAngle - activeSlotAngle))"
        }
      }
    },
    "dom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "children"],
      "properties": {
        "root": {
          "type": "object",
          "required": ["tag", "className", "dataAttr"],
          "properties": {
            "tag": { "type": "string", "const": "div" },
            "className": { "type": "string", "const": "radial-command" },
            "dataAttr": { "type": "string", "const": "data-radial-command" }
          }
        },
        "children": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["role", "className"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["field", "option", "hub", "hubLabel", "pointer", "replay"]
              },
              "className": { "type": "string" },
              "ariaRole": { "type": "string" }
            }
          }
        }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radiogroupPattern", "keyboardOperable", "hubAndPointerDecorative"],
      "properties": {
        "radiogroupPattern": { "type": "boolean", "const": true },
        "keyboardOperable": {
          "type": "boolean",
          "const": true,
          "description": "ArrowLeft/ArrowRight move selection; native <button> handles Enter/Space."
        },
        "hubAndPointerDecorative": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dropTransformFromTransition", "keepColourTransition", "triggers"],
      "properties": {
        "dropTransformFromTransition": {
          "type": "boolean",
          "const": true,
          "description": "Option position updates snap instantly; only background/colour still transition softly."
        },
        "keepColourTransition": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "enum": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"] }
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "field", "option", "hub", "hubLabel", "hubLabelPunch", "pointer", "replay"],
      "properties": {
        "root": { "type": "string", "const": "radial-command" },
        "field": { "type": "string", "const": "radial-command__field" },
        "option": { "type": "string", "const": "radial-command__option" },
        "hub": { "type": "string", "const": "radial-command__hub" },
        "hubLabel": { "type": "string", "const": "radial-command__hub-label" },
        "hubLabelPunch": { "type": "string", "const": "radial-command__hub-label--punch" },
        "pointer": { "type": "string", "const": "radial-command__pointer" },
        "replay": { "type": "string", "const": "radial-command-replay" }
      }
    }
  }
}
