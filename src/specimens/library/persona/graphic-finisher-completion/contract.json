{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/graphic-finisher-completion.schema.json",
  "title": "GraphicFinisherCompletion",
  "description": "Portable visual/component contract for a Persona-inspired capstone completion overlay: panel shutter, flash, word slam, ring/shard burst, subline. Not a database schema. No copyrighted assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "colours",
    "animation",
    "dom",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "graphic-finisher-completion" },
    "intent": {
      "type": "string",
      "const": "Panel shutter cascade, full-bleed flash, darkened backdrop, giant word slam, ring/shard burst, and rising caption — the largest completion punctuation in the set."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "subline"],
      "properties": {
        "word": { "type": "string", "const": "COMPLETE" },
        "subline": { "type": "string", "const": "All objectives cleared" }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "accent", "paper", "flash"],
      "properties": {
        "ink": { "type": "string", "const": "#0d0d0d" },
        "accent": { "type": "string", "const": "#d71920" },
        "paper": { "type": "string", "const": "#f2eee3" },
        "flash": { "type": "string", "const": "#f8f6f0" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panelSweep", "backdropFade", "flash", "wordSlam", "rings", "shards", "sublineRise", "exit", "stageOrder"],
      "properties": {
        "panelSweep": {
          "type": "object",
          "required": ["name", "durationMs", "staggerMsList"],
          "properties": {
            "name": { "type": "string", "const": "finisher-panel-sweep" },
            "durationMs": { "type": "number", "const": 220 },
            "staggerMsList": { "type": "array", "const": [0, 70, 140] }
          }
        },
        "backdropFade": {
          "type": "object",
          "required": ["durationMs", "delayMs"],
          "properties": {
            "durationMs": { "type": "number", "const": 320 },
            "delayMs": { "type": "number", "const": 260 }
          }
        },
        "flash": {
          "type": "object",
          "required": ["name", "durationMs", "delayMs"],
          "properties": {
            "name": { "type": "string", "const": "finisher-flash" },
            "durationMs": { "type": "number", "const": 220 },
            "delayMs": { "type": "number", "const": 260 }
          }
        },
        "wordSlam": {
          "type": "object",
          "required": ["name", "durationMs", "timingFunction", "delayMs", "keyframes"],
          "properties": {
            "name": { "type": "string", "const": "finisher-word-slam" },
            "durationMs": { "type": "number", "const": 420 },
            "timingFunction": { "type": "string", "const": "cubic-bezier(0.16, 0.85, 0.2, 1.16)" },
            "delayMs": { "type": "number", "const": 300 },
            "keyframes": {
              "type": "object",
              "required": ["from", "impact", "to"],
              "properties": {
                "from": { "type": "object", "const": { "scale": 1.7, "rotate": "-4deg", "opacity": 0 } },
                "impact": { "type": "object", "const": { "atPercent": 60, "scale": 0.94, "rotate": "1deg", "opacity": 1 } },
                "to": { "type": "object", "const": { "scale": 1, "rotate": "0deg", "opacity": 1 } }
              }
            }
          }
        },
        "rings": {
          "type": "object",
          "required": ["name", "count", "durationMs", "staggerMsList"],
          "properties": {
            "name": { "type": "string", "const": "finisher-ring" },
            "count": { "type": "integer", "const": 3 },
            "durationMs": { "type": "number", "const": 460 },
            "staggerMsList": { "type": "array", "const": [420, 480, 540] }
          }
        },
        "shards": {
          "type": "object",
          "required": ["name", "count", "durationMs", "delayMs"],
          "properties": {
            "name": { "type": "string", "const": "finisher-shard" },
            "count": { "type": "integer", "const": 6 },
            "durationMs": { "type": "number", "const": 260 },
            "delayMs": { "type": "number", "const": 440 }
          }
        },
        "sublineRise": {
          "type": "object",
          "required": ["name", "durationMs", "delayMs"],
          "properties": {
            "name": { "type": "string", "const": "finisher-subline-rise" },
            "durationMs": { "type": "number", "const": 260 },
            "delayMs": { "type": "number", "const": 760 }
          }
        },
        "exit": {
          "type": "object",
          "required": ["name", "durationMs", "timingFunction"],
          "properties": {
            "name": { "type": "string", "const": "finisher-exit-fade" },
            "durationMs": { "type": "number", "const": 260 },
            "timingFunction": { "type": "string", "const": "ease-in" }
          }
        },
        "stageOrder": {
          "type": "array",
          "const": ["panels", "backdrop-and-flash", "word", "rings-and-shards", "subline"]
        }
      }
    },
    "dom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "children"],
      "properties": {
        "root": {
          "type": "object",
          "required": ["tag", "className", "dataAttr"],
          "properties": {
            "tag": { "type": "string", "const": "div" },
            "className": { "type": "string", "const": "finisher" },
            "dataAttr": { "type": "string", "const": "data-finisher" }
          }
        },
        "children": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["role", "className"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["backdrop", "panels", "panel", "flash", "content", "word", "rings", "ring", "subline", "shards", "shard", "replay"]
              },
              "className": { "type": "string" },
              "ariaHidden": { "type": "boolean" }
            }
          }
        }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wholeOverlayDecorative", "announceStatusSeparately", "doNotRelyOnMotionAlone"],
      "properties": {
        "wholeOverlayDecorative": { "type": "boolean", "const": true },
        "announceStatusSeparately": { "type": "boolean", "const": true },
        "doNotRelyOnMotionAlone": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["showStaticSettled", "exitBecomesInstant", "triggers"],
      "properties": {
        "showStaticSettled": {
          "type": "boolean",
          "const": true,
          "description": "Skip panels/flash/rings/shards; show dark backdrop, word, and subline immediately."
        },
        "exitBecomesInstant": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "enum": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"] }
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "backdrop", "panels", "flash", "content", "word", "rings", "subline", "shards", "replay", "stateEnter", "stateSettled", "stateExit"],
      "properties": {
        "root": { "type": "string", "const": "finisher" },
        "backdrop": { "type": "string", "const": "finisher__backdrop" },
        "panels": { "type": "string", "const": "finisher__panels" },
        "flash": { "type": "string", "const": "finisher__flash" },
        "content": { "type": "string", "const": "finisher__content" },
        "word": { "type": "string", "const": "finisher__word" },
        "rings": { "type": "string", "const": "finisher__rings" },
        "subline": { "type": "string", "const": "finisher__subline" },
        "shards": { "type": "string", "const": "finisher__shards" },
        "replay": { "type": "string", "const": "finisher-replay" },
        "stateEnter": { "type": "string", "const": "finisher--enter" },
        "stateSettled": { "type": "string", "const": "finisher--settled" },
        "stateExit": { "type": "string", "const": "finisher--exit" }
      }
    }
  }
}
