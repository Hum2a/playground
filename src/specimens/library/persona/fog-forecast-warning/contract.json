{
  "name": "fog-forecast-warning",
  "intent": "Upcoming fog/deadline creates a prominent forecast alert with escalating stages.",
  "catalogue": { "p4": "P4-105", "ref": "SPX-3023" },
  "colours": {
    "yellow": "#F5C400",
    "ink": "#101010",
    "paper": "#F7F3E8",
    "muted": "#E8E8E8"
  },
  "stages": [
    { "id": "watch", "label": "WATCH", "atMs": 0 },
    { "id": "advisory", "label": "ADVISORY", "atMs": 700 },
    { "id": "alert", "label": "ALERT", "atMs": 1400 }
  ],
  "timing": { "stageMs": 700, "totalMs": 2100 },
  "api": { "run": "runFogForecast()", "reset": "resetFogForecast()" },
  "reducedMotion": { "behaviour": "Final ALERT stage shown immediately" }
}
