{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/red-stamp-unlock.schema.json",
  "title": "RedStampUnlock",
  "description": "Portable visual/component contract for a Persona-inspired hand-struck ink stamp unlock overlay. Not a database schema. No copyrighted assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "layout",
    "colours",
    "animation",
    "dom",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "red-stamp-unlock" },
    "intent": {
      "type": "string",
      "const": "Hand-struck red ink ring stamp that smashes onto a locked surface for an unlock / status-confirmation reveal."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "sub", "srOnlyLabel"],
      "properties": {
        "word": { "type": "string", "const": "UNLOCKED" },
        "sub": { "type": "string", "const": "ACCESS · GRANTED" },
        "srOnlyLabel": {
          "type": "string",
          "const": "Content unlocked",
          "description": "Screen-reader status on the host scaffold; not inside the decorative mark."
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markSize",
        "finalRotationDegrees",
        "outerRingBorderPx",
        "outerRingRadius",
        "innerRingSizePercent",
        "innerRingBorderPx",
        "innerRingRadius",
        "particleCount",
        "parentRequirements"
      ],
      "properties": {
        "markSize": { "type": "string", "const": "min(62%, 230px)" },
        "finalRotationDegrees": { "type": "number", "const": -8 },
        "outerRingBorderPx": { "type": "number", "const": 5 },
        "outerRingRadius": {
          "type": "string",
          "const": "48% 52% 51% 49% / 53% 47% 52% 48%"
        },
        "innerRingSizePercent": { "type": "number", "const": 82 },
        "innerRingBorderPx": { "type": "number", "const": 3 },
        "innerRingRadius": {
          "type": "string",
          "const": "51% 49% 47% 53% / 49% 53% 46% 51%"
        },
        "particleCount": { "type": "integer", "const": 5 },
        "parentRequirements": {
          "type": "array",
          "items": { "type": "string" },
          "const": ["position:relative", "overflow:hidden"]
        }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["red", "black"],
      "properties": {
        "red": { "type": "string", "const": "#c81324" },
        "black": { "type": "string", "const": "#0d0d0d" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enter", "ink", "particles", "exit"],
      "properties": {
        "enter": {
          "type": "object",
          "required": ["name", "durationMs", "timingFunction", "keyframes"],
          "properties": {
            "name": { "type": "string", "const": "stamp-unlock-slam" },
            "durationMs": { "type": "number", "const": 520 },
            "timingFunction": {
              "type": "string",
              "const": "cubic-bezier(0.16, 0.9, 0.24, 1.14)"
            },
            "keyframes": {
              "type": "object",
              "required": ["from", "impact", "recoil", "to"],
              "properties": {
                "from": {
                  "type": "object",
                  "const": {
                    "translate": "58% -68%",
                    "rotate": "38deg",
                    "scale": 1.9,
                    "opacity": 0
                  }
                },
                "impact": {
                  "type": "object",
                  "const": {
                    "atPercent": 55,
                    "rotate": "-14deg",
                    "scale": 1.06,
                    "opacity": 1
                  }
                },
                "recoil": {
                  "type": "object",
                  "const": { "atPercent": 78, "rotate": "-4deg", "scale": 0.98 }
                },
                "to": {
                  "type": "object",
                  "const": { "rotate": "-8deg", "scale": 1, "opacity": 1 }
                }
              }
            }
          }
        },
        "ink": {
          "type": "object",
          "required": ["name", "durationMs", "delayMs", "timingFunction"],
          "properties": {
            "name": { "type": "string", "const": "stamp-unlock-ink" },
            "durationMs": { "type": "number", "const": 380 },
            "delayMs": { "type": "number", "const": 260 },
            "timingFunction": { "type": "string", "const": "ease-out" }
          }
        },
        "particles": {
          "type": "object",
          "required": ["name", "count", "durationMs", "delayMs"],
          "properties": {
            "name": { "type": "string", "const": "stamp-unlock-particle" },
            "count": { "type": "integer", "const": 5 },
            "durationMs": { "type": "number", "const": 220 },
            "delayMs": { "type": "number", "const": 280 }
          }
        },
        "exit": {
          "type": "object",
          "required": ["name", "durationMs", "timingFunction", "keyframes"],
          "properties": {
            "name": { "type": "string", "const": "stamp-unlock-lift" },
            "durationMs": { "type": "number", "const": 240 },
            "timingFunction": { "type": "string", "const": "ease-in" },
            "keyframes": {
              "type": "object",
              "required": ["from", "to"],
              "properties": {
                "from": {
                  "type": "object",
                  "const": { "rotate": "-8deg", "scale": 1, "opacity": 1 }
                },
                "to": {
                  "type": "object",
                  "const": {
                    "rotate": "-16deg",
                    "scale": 0.6,
                    "translateY": "-14%",
                    "opacity": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "dom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "children"],
      "properties": {
        "root": {
          "type": "object",
          "required": ["tag", "className", "dataAttr"],
          "properties": {
            "tag": { "type": "string", "const": "div" },
            "className": { "type": "string", "const": "stamp-unlock" },
            "dataAttr": { "type": "string", "const": "data-stamp-unlock" }
          }
        },
        "children": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["role", "className"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["ink", "mark", "ring", "word", "sub", "particles", "particle", "replay"]
              },
              "className": { "type": "string" },
              "ariaHidden": { "type": "boolean" }
            }
          }
        }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markDecorative", "particlesDecorative", "announceStatusSeparately", "doNotRelyOnMotionAlone"],
      "properties": {
        "markDecorative": { "type": "boolean", "const": true },
        "particlesDecorative": { "type": "boolean", "const": true },
        "announceStatusSeparately": { "type": "boolean", "const": true },
        "doNotRelyOnMotionAlone": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["showStaticSettled", "triggers"],
      "properties": {
        "showStaticSettled": {
          "type": "boolean",
          "const": true,
          "description": "Skip slam/ink-halo/particles; show final -8deg mark immediately."
        },
        "triggers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "enum": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"]
          }
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "ink", "mark", "ringOuter", "ringInner", "word", "sub", "particles", "particle", "replay"],
      "properties": {
        "root": { "type": "string", "const": "stamp-unlock" },
        "ink": { "type": "string", "const": "stamp-unlock__ink" },
        "mark": { "type": "string", "const": "stamp-unlock__mark" },
        "ringOuter": { "type": "string", "const": "stamp-unlock__ring--outer" },
        "ringInner": { "type": "string", "const": "stamp-unlock__ring--inner" },
        "word": { "type": "string", "const": "stamp-unlock__word" },
        "sub": { "type": "string", "const": "stamp-unlock__sub" },
        "particles": { "type": "string", "const": "stamp-unlock__particles" },
        "particle": { "type": "string", "const": "stamp-unlock__particle" },
        "replay": { "type": "string", "const": "stamp-unlock-replay" },
        "stateEnter": { "type": "string", "const": "stamp-unlock--enter" },
        "stateExit": { "type": "string", "const": "stamp-unlock--exit" },
        "stateSettled": { "type": "string", "const": "stamp-unlock--settled" },
        "stateReduced": { "type": "string", "const": "stamp-unlock--reduced" }
      }
    }
  }
}
