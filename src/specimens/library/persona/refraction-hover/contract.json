{
  "name": "refraction-hover",
  "intent": "A semantic glass dossier card refracts two clipped pseudo-element panes on hover or keyboard focus.",
  "geometry": {
    "cardWidthPx": 280,
    "cardHeightPx": 170,
    "borderPx": 1
  },
  "copy": {
    "index": "03 / GLASS",
    "title": "CASE FILE",
    "detail": "ENTER ARCHIVE"
  },
  "colours": {
    "night": "#090D18",
    "glass": "#172B46",
    "edge": "#A9C8DF",
    "paper": "#EDF5FA",
    "cyan": "#7ED7EF",
    "violet": "#A49CFF"
  },
  "refraction": {
    "implementation": "card::before and card::after clipped panes",
    "rest": {
      "cyan": "translate(-8px, 6px) skewX(-8deg)",
      "violet": "translate(7px, -5px) skewX(-8deg)"
    },
    "active": {
      "cyan": "translate(17px, -8px) skewX(-8deg)",
      "violet": "translate(-17px, 10px) skewX(-8deg)"
    },
    "noFilters": true,
    "noCanvas": true
  },
  "motion": {
    "loops": false,
    "enterMs": 220,
    "enterEasing": "cubic-bezier(0.18, 0.85, 0.28, 1)",
    "exitMs": 140,
    "exitEasing": "cubic-bezier(0.6, 0, 0.9, 0.4)"
  },
  "a11y": {
    "control": "anchor",
    "focusVisible": "2px solid #7ED7EF",
    "focusMatchesHover": true,
    "decorativeLayersPointerEventsNone": true
  },
  "reducedMotion": {
    "triggers": [
      "@media (prefers-reduced-motion: reduce)",
      "[data-force-reduced-motion=\"true\"]"
    ],
    "behaviour": "Immediate final refraction on hover/focus and immediate restoration on exit."
  },
  "constraints": {
    "cssOnly": true,
    "noExternalAssets": true,
    "noFilters": true,
    "noCanvas": true
  }
}
