{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/critical-capture.schema.json",
  "title": "CriticalCapture",
  "description": "Portable contract for the decisive, single-lock sibling of Capture Shake.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "family", "intent", "copy", "colours", "geometry", "timing", "api", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "critical-capture" },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseSpecimen", "relationship"],
      "properties": {
        "baseSpecimen": { "type": "string", "const": "capture-shake" },
        "relationship": { "type": "string", "const": "Decisive single-lock success sibling; replaces Capture Shake's three-check path." }
      }
    },
    "intent": { "type": "string", "const": "Exceptional fast-path capture: a normal enter/close begins, then one unusually sharp lock replaces a three-check uncertainty sequence and immediately confirms VERIFIED." },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "initial", "final", "trigger"],
      "properties": {
        "entity": { "type": "string", "const": "ENTITY // 027" },
        "initial": { "type": "string", "const": "VERIFYING" },
        "final": { "type": "string", "const": "VERIFIED" },
        "trigger": { "type": "string", "const": "CAPTURE" }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "panel", "steel", "edge", "pale", "muted", "crit", "glow"],
      "properties": {
        "ink": { "type": "string", "const": "#0c1014" },
        "panel": { "type": "string", "const": "#161c22" },
        "steel": { "type": "string", "const": "#2a343e" },
        "edge": { "type": "string", "const": "#4a5866" },
        "pale": { "type": "string", "const": "#e8eef4" },
        "muted": { "type": "string", "const": "#8a97a4" },
        "crit": { "type": "string", "const": "#d8e6f2" },
        "glow": { "type": "string", "const": "#9ec4e8" }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devicePx", "noOfficialPokeBallArtwork", "criticalRays", "rayExtendPx", "confirmRingScale"],
      "properties": {
        "devicePx": { "type": "number", "const": 112 },
        "noOfficialPokeBallArtwork": { "type": "boolean", "const": true },
        "criticalRays": { "type": "number", "const": 4 },
        "rayExtendPx": { "type": "number", "const": 18 },
        "confirmRingScale": { "type": "array", "const": [1, 1.28] }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enterMs", "closeMs", "pauseMs", "lockMs", "lockRotationDeg", "lockScale", "ringMs", "totalMs", "shakeCount", "noThreeShakeSequence", "noLoop"],
      "properties": {
        "enterMs": { "type": "number", "const": 220 },
        "closeMs": { "type": "number", "const": 80 },
        "pauseMs": { "type": "number", "const": 100 },
        "lockMs": { "type": "number", "const": 170 },
        "lockRotationDeg": { "type": "array", "const": [0, 14, -5, 0] },
        "lockScale": { "type": "array", "const": [1, 0.94, 1.03, 1] },
        "ringMs": { "type": "number", "const": 160 },
        "totalMs": { "type": "number", "const": 730 },
        "shakeCount": { "type": "number", "const": 1 },
        "noThreeShakeSequence": { "type": "boolean", "const": true },
        "noLoop": { "type": "boolean", "const": true }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture", "reset", "busyGuard"],
      "properties": {
        "capture": { "type": "string", "const": "runCriticalCapture()" },
        "reset": { "type": "string", "const": "runCriticalCaptureReset()" },
        "busyGuard": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggers", "behaviour"],
      "properties": {
        "triggers": { "type": "array", "const": ["@media (prefers-reduced-motion: reduce)", "[data-force-reduced-motion=\"true\"]"] },
        "behaviour": { "type": "string", "const": "Immediately show VERIFIED and locked container" }
      }
    }
  }
}
