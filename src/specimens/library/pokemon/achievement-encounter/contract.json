{
  "name": "achievement-encounter",
  "intent": "Original abstract rare encounter: streaks, arena, signal flash, then an anomaly-identification message — without Pokémon assets.",
  "colours": {
    "ground": "#54664b",
    "sky": "#9fc8cf",
    "ink": "#20252a",
    "paper": "#f7f4df",
    "gold": "#e9b83f",
    "platform": "#4f8748"
  },
  "dimensions": {
    "minHeightPx": 240,
    "signalSizePx": 96,
    "streakCount": 8,
    "messageInsetPercent": 8
  },
  "copy": {
    "trigger": "BEGIN ENCOUNTER",
    "message": "A RARE PRESENCE EMERGES.",
    "title": "ANOMALY 010",
    "signalCode": "SIGNAL-10",
    "signalGlyph": "✦",
    "statusAnnounce": "Rare encounter identified: Anomaly 010"
  },
  "classes": {
    "root": "ae",
    "active": "ae--active",
    "streaks": "ae--streaks",
    "arena": "ae--arena",
    "signal": "ae--signal",
    "message": "ae--message",
    "settled": "ae--settled",
    "reduced": "ae--reduced"
  },
  "timing": {
    "totalMs": 1250,
    "streakMs": 350,
    "arenaMs": 250,
    "signalMs": 400,
    "messageMs": 250,
    "easing": "steps(2–4, end)"
  },
  "api": {
    "run": "runAchievementEncounter()",
    "reset": "resetAchievementEncounter()",
    "replay": "replayAchievementEncounter()",
    "busyGuard": true,
    "sandboxSafe": true,
    "restartMessage": true
  },
  "a11y": {
    "trigger": "button",
    "decorativeAriaHidden": ["streaks", "arena", "signal", "message"],
    "statusRole": "status",
    "ariaLive": "polite",
    "announceOnceOnSettle": true
  },
  "reducedMotion": {
    "triggers": [
      "@media (prefers-reduced-motion: reduce)",
      "[data-force-reduced-motion=\"true\"]"
    ],
    "behaviour": "Skip streaks; immediately show arena + signal + message; still announce once"
  },
  "constraints": {
    "noPokemonAssets": true,
    "noCreatureImagery": true,
    "noExternalAssets": true,
    "noInfiniteMotion": true,
    "noNetwork": true,
    "widthRangePx": [320, 768]
  }
}
