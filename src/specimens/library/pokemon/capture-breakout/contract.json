{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/capture-breakout.schema.json",
  "title": "CaptureBreakout",
  "description": "Portable contract for the failure sibling of Capture Shake.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "family", "intent", "copy", "colours", "geometry", "timing", "api", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "capture-breakout" },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseSpecimen", "relationship"],
      "properties": {
        "baseSpecimen": { "type": "string", "const": "capture-shake" },
        "relationship": { "type": "string", "const": "Failure sibling; follows two Capture Shake checks before interrupting the third and escaping." }
      }
    },
    "intent": { "type": "string", "const": "Failure counterpart to Capture Shake: two complete uncertainty checks, an interrupted third, then structural container open and entity escape to ESCAPED." },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "paper", "coral", "gold"],
      "properties": {
        "ink": { "type": "string", "const": "#171c20" },
        "paper": { "type": "string", "const": "#f1efe2" },
        "coral": { "type": "string", "const": "#d95b4e" },
        "gold": { "type": "string", "const": "#f0b84a" }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "processing", "final", "trigger", "retry"],
      "properties": {
        "entity": { "type": "string", "const": "ENTITY // UNKNOWN" },
        "processing": { "type": "string", "const": "RESOLVING" },
        "final": { "type": "string", "const": "ESCAPED" },
        "trigger": { "type": "string", "const": "CAPTURE" },
        "retry": { "type": "string", "const": "RETRY" }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devicePx", "noOfficialPokeBallArtwork", "breakoutRays", "upperBreak", "lowerBreak", "escapeTranslateYPx", "escapeScale", "compressScaleY"],
      "properties": {
        "devicePx": { "type": "number", "const": 120 },
        "noOfficialPokeBallArtwork": { "type": "boolean", "const": true },
        "breakoutRays": { "type": "number", "const": 6 },
        "upperBreak": { "type": "object", "const": { "translateYPx": -18, "rotateDeg": -6 } },
        "lowerBreak": { "type": "object", "const": { "translateYPx": 18, "rotateDeg": 5 } },
        "escapeTranslateYPx": { "type": "number", "const": -95 },
        "escapeScale": { "type": "array", "const": [0.5, 1.08, 1] },
        "compressScaleY": { "type": "number", "const": 0.9 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enterMs", "closeMs", "shake1Ms", "pause1Ms", "shake2Ms", "longPauseMs", "shake3FullMs", "shake3InterruptFraction", "shake3PartialMs", "compressMs", "escapeMs", "recoverMs", "completeChecks", "noContinuousShake", "noThreeCompleteChecks"],
      "properties": {
        "enterMs": { "type": "number", "const": 240 },
        "closeMs": { "type": "number", "const": 160 },
        "shake1Ms": { "type": "number", "const": 220 },
        "pause1Ms": { "type": "number", "const": 180 },
        "shake2Ms": { "type": "number", "const": 220 },
        "longPauseMs": { "type": "number", "const": 280 },
        "shake3FullMs": { "type": "number", "const": 220 },
        "shake3InterruptFraction": { "type": "number", "const": 0.4 },
        "shake3PartialMs": { "type": "number", "const": 88 },
        "compressMs": { "type": "number", "const": 70 },
        "escapeMs": { "type": "number", "const": 420 },
        "recoverMs": { "type": "number", "const": 280 },
        "completeChecks": { "type": "number", "const": 2 },
        "noContinuousShake": { "type": "boolean", "const": true },
        "noThreeCompleteChecks": { "type": "boolean", "const": true }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture", "retry", "busyGuard"],
      "properties": {
        "capture": { "type": "string", "const": "runCaptureBreakout()" },
        "retry": { "type": "string", "const": "runCaptureBreakoutRetry()" },
        "busyGuard": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggers", "behaviour"],
      "properties": {
        "triggers": { "type": "array", "const": ["@media (prefers-reduced-motion: reduce)", "[data-force-reduced-motion=\"true\"]"] },
        "behaviour": { "type": "string", "const": "Immediately show target outside open container with ESCAPED" }
      }
    }
  }
}
