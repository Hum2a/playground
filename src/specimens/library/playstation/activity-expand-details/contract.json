{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/activity-expand-details.schema.json",
  "title": "ActivityExpandDetails",
  "description": "Compact objective card expands into tasks, rewards, and actions — not a height bump alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "catalogue", "preview", "layout", "motion", "reducedMotion", "colours", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "activity-expand-details" },
    "intent": {
      "type": "string",
      "const": "Compact objective card expands to expose tasks, rewards, and actions."
    },
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ps", "ref"],
      "properties": {
        "ps": { "type": "string", "const": "PS-038" },
        "ref": { "type": "string", "const": "SPX-3344" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx", "overflow"],
      "properties": {
        "widthPx": { "type": "number", "const": 440 },
        "heightPx": { "type": "number", "const": 360 },
        "overflow": { "type": "string", "const": "hidden" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskCount", "doneCount", "rewardLabels", "actionLabels"],
      "properties": {
        "taskCount": { "type": "number", "const": 5 },
        "doneCount": { "type": "number", "const": 2 },
        "rewardLabels": {
          "type": "array",
          "const": ["120 XP", "Badge fragment"]
        },
        "actionLabels": {
          "type": "array",
          "const": ["Resume", "Track", "Dismiss"]
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expandMs", "revealMs"],
      "properties": {
        "expandMs": { "type": "number", "const": 280 },
        "revealMs": { "type": "number", "const": 220 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggers", "behavior"],
      "properties": {
        "triggers": {
          "type": "array",
          "const": ["prefers-reduced-motion", "data-force-reduced-motion"]
        },
        "behavior": {
          "type": "string",
          "const": "Expand and collapse snap with no card/details/chevron transition."
        }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "ink", "paper", "soft"],
      "properties": {
        "primary": { "type": "string", "const": "#2E90FF" },
        "ink": { "type": "string", "const": "#0B0F14" },
        "paper": { "type": "string", "const": "#F4F6F8" },
        "soft": { "type": "string", "const": "#7EB6FF" }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "details", "tasks", "rewards", "actions"],
      "properties": {
        "root": { "type": "string", "const": "aed" },
        "details": { "type": "string", "const": "aed__details" },
        "tasks": { "type": "string", "const": "aed__tasks" },
        "rewards": { "type": "string", "const": "aed__rewards" },
        "actions": { "type": "string", "const": "aed__actions" }
      }
    }
  }
}
