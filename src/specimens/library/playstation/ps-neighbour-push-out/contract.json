{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/ps-neighbour-push-out.schema.json",
  "title": "PsNeighbourPushOut",
  "description": "Focused card expands; neighbours yield by frozen push distances and restore when focus leaves.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "catalogue", "preview", "layout", "motion", "reducedMotion", "colours", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "ps-neighbour-push-out" },
    "intent": {
      "type": "string",
      "const": "Adjacent cards move aside when the selected tile expands for focus, then restore."
    },
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ps", "ref"],
      "properties": {
        "ps": { "type": "string", "const": "PS-076" },
        "ref": { "type": "string", "const": "SPX-3382" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx", "overflow"],
      "properties": {
        "widthPx": { "type": "number", "const": 420 },
        "heightPx": { "type": "number", "const": 300 },
        "overflow": { "type": "string", "const": "hidden" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardCount", "idleWidthPx", "focusWidthPx", "cardHeightPx", "focusScale", "pushNearPx", "pushMidPx", "pushFarPx"],
      "properties": {
        "cardCount": { "type": "number", "const": 3 },
        "idleWidthPx": { "type": "number", "const": 92 },
        "focusWidthPx": { "type": "number", "const": 112 },
        "cardHeightPx": { "type": "number", "const": 128 },
        "focusScale": { "type": "number", "const": 1.06 },
        "pushNearPx": { "type": "number", "const": 20 },
        "pushMidPx": { "type": "number", "const": 24 },
        "pushFarPx": { "type": "number", "const": 36 }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pushMs", "easing"],
      "properties": {
        "pushMs": { "type": "number", "const": 300 },
        "easing": { "type": "string", "const": "cubic-bezier(0.22, 0.61, 0.36, 1)" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggers", "behavior"],
      "properties": {
        "triggers": {
          "type": "array",
          "const": ["prefers-reduced-motion", "data-force-reduced-motion"]
        },
        "behavior": {
          "type": "string",
          "const": "Disable .pnpo__card transitions; expand and neighbour offsets apply instantly."
        }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "ink", "paper", "soft"],
      "properties": {
        "primary": { "type": "string", "const": "#2E90FF" },
        "ink": { "type": "string", "const": "#0B0F14" },
        "paper": { "type": "string", "const": "#F4F6F8" },
        "soft": { "type": "string", "const": "#7EB6FF" }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "card", "focused"],
      "properties": {
        "root": { "type": "string", "const": "pnpo" },
        "card": { "type": "string", "const": "pnpo__card" },
        "focused": { "type": "string", "const": "is-focused" }
      }
    }
  }
}
