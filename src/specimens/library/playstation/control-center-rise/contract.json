{
  "name": "control-center-rise",
  "intent": "Compact control strip rises from the bottom while the active game remains visually present.",
  "catalogue": { "ps": "PS-001", "ref": "SPX-3307" },
  "copy": {
    "game": "TITLE A",
    "slots": ["Friends", "Media", "Party", "Store", "Settings"]
  },
  "colours": {
    "primary": "#2E90FF",
    "ink": "#0B0F14",
    "paper": "#F4F6F8",
    "soft": "#7EB6FF"
  },
  "timing": {
    "riseMs": 420,
    "riseEasing": "cubic-bezier(0.2, 1, 0.3, 1)",
    "gameBlurPx": 5
  },
  "api": {
    "open": "openControlCenter()",
    "dismiss": "dismissControlCenter()",
    "toggle": "toggleControlCenter()"
  },
  "reducedMotion": {
    "behaviour": "Strip and game blur snap instantly; no slide or filter transition"
  }
}
