{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/context-background-crossfade.schema.json",
  "title": "ContextBackgroundCrossfade",
  "description": "Three title-keyed background art planes crossfade by opacity only — A→B never flashes ink.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "catalogue", "preview", "layout", "motion", "reducedMotion", "colours", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "context-background-crossfade" },
    "intent": {
      "type": "string",
      "const": "Title-keyed ambient planes crossfade on focus change with no ink flash between layers."
    },
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ps", "ref"],
      "properties": {
        "ps": { "type": "string", "const": "PS-005" },
        "ref": { "type": "string", "const": "SPX-3311" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx", "overflow"],
      "properties": {
        "widthPx": { "type": "number", "const": 400 },
        "heightPx": { "type": "number", "const": 300 },
        "overflow": { "type": "string", "const": "hidden" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tileCount", "planeCount", "layers"],
      "properties": {
        "tileCount": { "type": "number", "const": 3 },
        "planeCount": { "type": "number", "const": 3 },
        "layers": { "type": "array", "const": ["a", "b", "c"] }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crossfadeMs", "easing", "property"],
      "properties": {
        "crossfadeMs": { "type": "number", "const": 600 },
        "easing": { "type": "string", "const": "ease" },
        "property": { "type": "string", "const": "opacity" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggers", "behavior"],
      "properties": {
        "triggers": {
          "type": "array",
          "const": ["prefers-reduced-motion", "data-force-reduced-motion"]
        },
        "behavior": {
          "type": "string",
          "const": "Disable .cbc__bg opacity transition; active plane snaps instantly."
        }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "ink", "paper", "soft"],
      "properties": {
        "primary": { "type": "string", "const": "#2E90FF" },
        "ink": { "type": "string", "const": "#0B0F14" },
        "paper": { "type": "string", "const": "#F4F6F8" },
        "soft": { "type": "string", "const": "#7EB6FF" }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "bg", "active", "tile", "label"],
      "properties": {
        "root": { "type": "string", "const": "cbc" },
        "bg": { "type": "string", "const": "cbc__bg" },
        "active": { "type": "string", "const": "is-active" },
        "tile": { "type": "string", "const": "cbc__tile" },
        "label": { "type": "string", "const": "cbc__label" }
      }
    }
  }
}
