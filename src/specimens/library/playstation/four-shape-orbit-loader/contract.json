{
  "name": "four-shape-orbit-loader",
  "ref": "SPX-3317",
  "intent": "Four original geometric symbols orbit a hub and settle onto a completion diamond.",
  "primitives": ["circle", "cross", "square", "triangle"],
  "colours": {
    "blue": "#2E90FF",
    "ink": "#0B0F14",
    "chalk": "#F4F6F8",
    "sky": "#7EB6FF"
  },
  "timing": {
    "orbitMs": 2400,
    "settleMs": 400
  },
  "settle": {
    "frame": "diamond",
    "vertices": ["N", "E", "S", "W"]
  },
  "api": {
    "complete": "COMPLETE button / data-fso-complete",
    "reset": "RESET button / data-fso-reset"
  },
  "reducedMotion": {
    "triggers": [
      "@media (prefers-reduced-motion: reduce)",
      "[data-force-reduced-motion=\"true\"]"
    ],
    "behaviour": "Settled diamond shown instantly; no orbit or counter-spin"
  }
}
