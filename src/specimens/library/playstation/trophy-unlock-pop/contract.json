{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/trophy-unlock-pop.schema.json",
  "title": "TrophyUnlockPop",
  "description": "Compact trophy toast enters, shines once, and settles.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "catalogue", "preview", "layout", "motion", "reducedMotion", "colours", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "trophy-unlock-pop" },
    "intent": {
      "type": "string",
      "const": "Compact trophy-like achievement notification enters, shines once, and settles."
    },
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ps", "ref"],
      "properties": {
        "ps": { "type": "string", "const": "PS-041" },
        "ref": { "type": "string", "const": "SPX-3347" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx", "overflow"],
      "properties": {
        "widthPx": { "type": "number", "const": 400 },
        "heightPx": { "type": "number", "const": 300 },
        "overflow": { "type": "string", "const": "hidden" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tierLabel", "title"],
      "properties": {
        "tierLabel": { "type": "string", "const": "Bronze tier" },
        "title": { "type": "string", "const": "First Steps" }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enterMs", "shineMs", "settleMs", "phases"],
      "properties": {
        "enterMs": { "type": "number", "const": 320 },
        "shineMs": { "type": "number", "const": 480 },
        "settleMs": { "type": "number", "const": 200 },
        "phases": {
          "type": "array",
          "const": ["idle", "enter", "shine", "settled"]
        }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggers", "behavior"],
      "properties": {
        "triggers": {
          "type": "array",
          "const": ["prefers-reduced-motion", "data-force-reduced-motion"]
        },
        "behavior": {
          "type": "string",
          "const": "Skip enter/shine; show settled toast immediately."
        }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "ink", "paper", "soft"],
      "properties": {
        "primary": { "type": "string", "const": "#2E90FF" },
        "ink": { "type": "string", "const": "#0B0F14" },
        "paper": { "type": "string", "const": "#F4F6F8" },
        "soft": { "type": "string", "const": "#7EB6FF" }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "toast", "shine"],
      "properties": {
        "root": { "type": "string", "const": "tup" },
        "toast": { "type": "string", "const": "tup__toast" },
        "shine": { "type": "string", "const": "tup__shine" }
      }
    }
  }
}
