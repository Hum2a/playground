{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/fade-through.schema.json",
  "title": "FadeThrough",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "preview", "timing", "reducedMotion", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "fade-through" },
    "intent": {
      "type": "string",
      "const": "Two-phase 300ms handoff: outgoing opacity 1→0 and scale 1→0.96 during 0–105ms; incoming 105–300ms; no full-opacity overlap."
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx"],
      "properties": {
        "widthPx": { "type": "number", "const": 340 },
        "heightPx": { "type": "number", "const": 420 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs", "phaseSplitMs", "scaleMin"],
      "properties": {
        "durationMs": { "type": "number", "const": 300 },
        "phaseSplitMs": { "type": "number", "const": 105 },
        "scaleMin": { "type": "number", "const": 0.96 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opacityHandoffMs", "triggers"],
      "properties": {
        "opacityHandoffMs": { "type": "number", "const": 80 },
        "triggers": {
          "type": "array",
          "const": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "viewport", "panel"],
      "properties": {
        "root": { "type": "string", "const": "ft" },
        "viewport": { "type": "string", "const": "ft__viewport" },
        "panel": { "type": "string", "const": "ft__panel" }
      }
    }
  }
}
