{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/snackbar-rise.schema.json",
  "title": "SnackbarRise",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "snackbar", "sequence", "reducedMotion", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "snackbar-rise" },
    "intent": {
      "type": "string",
      "const": "Snackbar rises after delete with UNDO row restore."
    },
    "snackbar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx", "bottomInsetPx"],
      "properties": {
        "widthPx": { "type": "number", "const": 344 },
        "heightPx": { "type": "number", "const": 52 },
        "bottomInsetPx": { "type": "number", "const": 20 }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryMs", "dwellMs", "restoreDwellMs"],
      "properties": {
        "entryMs": { "type": "number", "const": 250 },
        "dwellMs": { "type": "number", "const": 4500 },
        "restoreDwellMs": { "type": "number", "const": 900 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opacityOnly", "triggers"],
      "properties": {
        "opacityOnly": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "snackbar"],
      "properties": {
        "root": { "type": "string", "const": "sbr" },
        "snackbar": { "type": "string", "const": "sbr__snackbar" }
      }
    }
  }
}
