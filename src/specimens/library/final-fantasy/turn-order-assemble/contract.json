{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.local/docs/design/turn-order-assemble.schema.json",
  "title": "TurnOrderAssemble",
  "description": "Portable contract for an original six-token JRPG-style turn queue.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "copy", "colours", "layout", "motion", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "turn-order-assemble" },
    "copy": { "type": "object", "properties": { "actors": { "type": "array", "const": ["ALLY A", "ALLY B", "ENEMY A", "ALLY C", "ENEMY B", "ENEMY C"] } } },
    "colours": { "type": "object", "properties": { "navy": { "const": "#111827" }, "parchment": { "const": "#E9E3D2" }, "cyan": { "const": "#72D6E8" } } },
    "layout": { "type": "object", "properties": { "tokenCount": { "const": 6 }, "tokenPx": { "const": 42 }, "gapPx": { "const": 10 }, "connectorPx": { "const": 2 }, "activeScale": { "const": 1.15 } } },
    "motion": { "type": "object", "properties": { "entranceMs": { "const": 240 }, "staggerMs": { "const": 70 }, "runtimeRandomness": { "const": false } } },
    "reducedMotion": { "type": "object", "properties": { "completeTimelineImmediately": { "const": true }, "triggers": { "const": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"] } } }
  }
}
