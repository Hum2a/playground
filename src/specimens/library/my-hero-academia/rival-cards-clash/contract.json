{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RivalCardsClash",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "colours", "animation", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "rival-cards-clash" },
    "colours": {
      "type": "object",
      "required": ["primary", "ink", "paper", "accent"],
      "properties": {
        "primary": { "type": "string", "const": "#38A3FF" },
        "ink": { "type": "string", "const": "#101820" },
        "paper": { "type": "string", "const": "#F4F7FA" },
        "accent": { "type": "string", "const": "#FF4D35" }
      }
    },
    "animation": {
      "type": "object",
      "required": ["primaryMs", "totalMs"],
      "properties": {
        "primaryMs": { "type": "number", "const": 660 },
        "totalMs": { "type": "number", "const": 1310 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "required": ["triggers"],
      "properties": {
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"]
          }
        }
      }
    }
  }
}
