{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/charge-release.schema.json",
  "title": "ChargeRelease",
  "description": "Charge LOCAL deploy then RELEASE to PRODUCTION. Dragon Ball DB-004 / SPX-969. Original CSS only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "palette",
    "charge",
    "animation",
    "a11y",
    "reducedMotion",
    "classNames",
    "behaviour"
  ],
  "properties": {
    "name": { "type": "string", "const": "charge-release" },
    "intent": {
      "type": "string",
      "const": "Charge DEPLOY on LOCAL through a frozen ladder; RELEASE unlocks at 70%, canonical commit at 85% launches a travelling action with three afterimages and one impact ring; PRODUCTION becomes DEPLOYED."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "operation",
        "insufficient",
        "ready",
        "reversible",
        "committed",
        "deployed",
        "waiting"
      ],
      "properties": {
        "source": { "type": "string", "const": "LOCAL" },
        "target": { "type": "string", "const": "PRODUCTION" },
        "operation": { "type": "string", "const": "DEPLOY" },
        "insufficient": { "type": "string", "const": "INSUFFICIENT CHARGE" },
        "ready": { "type": "string", "const": "READY TO RELEASE" },
        "reversible": { "type": "string", "const": "REVERSIBLE" },
        "committed": { "type": "string", "const": "COMMITTED" },
        "deployed": { "type": "string", "const": "DEPLOYED" },
        "waiting": { "type": "string", "const": "WAITING" }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string",
        "enum": ["#070d14", "#0f1822", "#e4eef8", "#3db8ff", "#f0c14a"]
      }
    },
    "charge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "nodePx", "gatePct", "canonicalReleasePct"],
      "properties": {
        "steps": {
          "type": "array",
          "const": [0, 20, 40, 60, 70, 85, 100]
        },
        "nodePx": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "20", "40", "60", "70", "85", "100"],
          "properties": {
            "0": { "type": "integer", "const": 24 },
            "20": { "type": "integer", "const": 34 },
            "40": { "type": "integer", "const": 44 },
            "60": { "type": "integer", "const": 54 },
            "70": { "type": "integer", "const": 60 },
            "85": { "type": "integer", "const": 68 },
            "100": { "type": "integer", "const": 76 }
          }
        },
        "gatePct": { "type": "integer", "const": 70 },
        "canonicalReleasePct": { "type": "integer", "const": 85 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepMs",
        "compressMs",
        "compressScaleX",
        "travelMs",
        "afterimageCount",
        "impactMs",
        "impactTranslateX"
      ],
      "properties": {
        "stepMs": { "type": "integer", "const": 140 },
        "compressMs": { "type": "integer", "const": 70 },
        "compressScaleX": { "type": "array", "const": [1, 0.72] },
        "travelMs": { "type": "integer", "const": 340 },
        "afterimageCount": { "type": "integer", "const": 3 },
        "impactMs": { "type": "integer", "const": 120 },
        "impactTranslateX": {
          "type": "array",
          "const": [0, 4, -2, 0]
        },
        "impactRingCount": { "type": "integer", "const": 1 },
        "residue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["diameterPx", "colour", "persist"],
          "properties": {
            "diameterPx": { "type": "integer", "const": 52 },
            "colour": { "type": "string", "const": "#6ecf8e" },
            "persist": { "type": "boolean", "const": true }
          }
        },
        "deployMark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["diameterPx", "colour", "settleMs", "persist"],
          "properties": {
            "diameterPx": { "type": "integer", "const": 16 },
            "colour": { "type": "string", "const": "#6ecf8e" },
            "settleMs": { "type": "integer", "const": 200 },
            "persist": { "type": "boolean", "const": true }
          }
        },
        "laneTrailMs": { "type": "integer", "const": 340 }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveStatus", "releaseDisabledBelowGate"],
      "properties": {
        "liveStatus": { "type": "boolean", "const": true },
        "releaseDisabledBelowGate": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggers", "behaviour"],
      "properties": {
        "triggers": {
          "type": "array",
          "const": [
            "@media (prefers-reduced-motion: reduce)",
            "[data-force-reduced-motion='true']"
          ]
        },
        "behaviour": {
          "type": "string",
          "const": "On RELEASE, immediately show DEPLOYED / charge 0% / COMMITTED with no travel."
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "ready", "compressing", "travelling", "impacting", "complete"],
      "properties": {
        "root": { "type": "string", "const": "crl" },
        "ready": { "type": "string", "const": "is-ready" },
        "compressing": { "type": "string", "const": "is-compressing" },
        "travelling": { "type": "string", "const": "is-travelling" },
        "impacting": { "type": "string", "const": "is-impacting" },
        "complete": { "type": "string", "const": "is-complete" }
      }
    },
    "behaviour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "reset", "reversibleUntilRelease"],
      "properties": {
        "run": { "type": "string", "const": "runChargeRelease" },
        "reset": { "type": "string", "const": "resetChargeRelease" },
        "chargeSequence": { "type": "string", "const": "runChargeSequence" },
        "reversibleUntilRelease": { "type": "boolean", "const": true }
      }
    }
  }
}
