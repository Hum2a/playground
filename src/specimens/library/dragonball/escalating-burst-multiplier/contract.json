{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/escalating-burst-multiplier.schema.json",
  "title": "EscalatingBurstMultiplier",
  "description": "Portable contract for a stackable temporary performance multiplier with per-stage geometry and palette shifts on a risk ladder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "colours",
    "stages",
    "stageGeometry",
    "animation",
    "field",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "escalating-burst-multiplier" },
    "intent": {
      "type": "string",
      "const": "Risk ladder: each multiplier step changes core clip-path, halo, sector shape, and palette — not label alone — while throughput climbs and stability collapses."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "trigger", "reset"],
      "properties": {
        "system": { "type": "string", "const": "WORKER // 04" },
        "trigger": { "type": "string", "const": "INCREASE MULTIPLIER" },
        "reset": { "type": "string", "const": "RESET" }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bg", "fg", "stagePalettes"],
      "properties": {
        "bg": { "type": "string", "const": "#0c0e12" },
        "fg": { "type": "string", "const": "#e8e6df" },
        "stagePalettes": {
          "type": "array",
          "const": [
            { "stage": "1×", "mid": "#8fa86a", "bright": "#c8d89a", "edge": "#6a7a58" },
            { "stage": "2×", "mid": "#b4a050", "bright": "#e0cc6a", "edge": "#8a7840" },
            { "stage": "4×", "mid": "#c4a35a", "bright": "#e8d48b", "edge": "#a87838" },
            { "stage": "10×", "mid": "#d49248", "bright": "#f0c060", "edge": "#d97b5c" },
            { "stage": "20×", "mid": "#e06850", "bright": "#ffb088", "edge": "#ff4a30" }
          ]
        }
      }
    },
    "stages": {
      "type": "array",
      "const": [
        {
          "label": "1×",
          "output": "100/s",
          "load": 42,
          "stability": 100,
          "status": "NOMINAL",
          "contours": 0,
          "fragments": 0,
          "coreShape": "diamond"
        },
        {
          "label": "2×",
          "output": "200/s",
          "load": 58,
          "stability": 91,
          "status": "NOMINAL",
          "contours": 1,
          "fragments": 0,
          "coreShape": "hexagon",
          "halo": "dashed circle 68px"
        },
        {
          "label": "4×",
          "output": "400/s",
          "load": 72,
          "stability": 76,
          "status": "NOMINAL",
          "contours": 2,
          "fragments": 0,
          "coreShape": "octagon",
          "halo": "rounded square 78px",
          "sectorClip": "trapezoid"
        },
        {
          "label": "10×",
          "output": "1,000/s",
          "load": 89,
          "stability": 48,
          "status": "STRAINED",
          "contours": 3,
          "fragments": 4,
          "coreShape": "12-point burst",
          "halo": "organic blob 88px",
          "sectorClip": "chevron"
        },
        {
          "label": "20×",
          "output": "2,000/s",
          "load": 98,
          "stability": 17,
          "status": "UNSTABLE",
          "contours": 3,
          "fragments": 8,
          "brokenOuter": true,
          "coreShape": "shattered irregular",
          "halo": "dotted blob 96px",
          "sectorClip": "jagged shard"
        }
      ]
    },
    "stageGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreMorphs", "sectorCount", "maxFragments"],
      "properties": {
        "coreMorphs": {
          "type": "array",
          "const": ["diamond", "hexagon", "octagon", "12-point burst", "shattered irregular"]
        },
        "sectorCount": { "type": "number", "const": 4 },
        "maxFragments": { "type": "number", "const": 8 },
        "sectorShiftPx": { "type": "number", "const": 3 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slamMs", "holdMs", "sectorShiftPx", "hostScale", "loops"],
      "properties": {
        "slamMs": { "type": "number", "const": 120 },
        "holdMs": { "type": "number", "const": 100 },
        "sectorShiftPx": { "type": "number", "const": 3 },
        "hostScale": {
          "type": "array",
          "const": [0.97, 1.025, 1]
        },
        "loops": { "type": "boolean", "const": false }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectorCount", "maxFragments", "railIsStructural"],
      "properties": {
        "sectorCount": { "type": "number", "const": 4 },
        "maxFragments": { "type": "number", "const": 8 },
        "railIsStructural": { "type": "boolean", "const": true }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["politeStatus", "stabilityMeter", "metricsAreText"],
      "properties": {
        "politeStatus": { "type": "boolean", "const": true },
        "stabilityMeter": { "type": "boolean", "const": true },
        "metricsAreText": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateFinal", "triggers"],
      "properties": {
        "immediateFinal": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": [
            "prefers-reduced-motion: reduce",
            "data-force-reduced-motion=true"
          ]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "host", "field", "core", "rail", "mult"],
      "properties": {
        "root": { "type": "string", "const": "ebm" },
        "host": { "type": "string", "const": "ebm__host" },
        "field": { "type": "string", "const": "ebm__field" },
        "core": { "type": "string", "const": "ebm__core" },
        "rail": { "type": "string", "const": "ebm__rail" },
        "mult": { "type": "string", "const": "ebm__mult" }
      }
    }
  }
}
