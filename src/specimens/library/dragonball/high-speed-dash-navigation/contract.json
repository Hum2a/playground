{
  "name": "high-speed-dash-navigation",
  "intent": "Extreme-speed nav OVERVIEW→LOGS (320px) with opposite anticipation, five fixed speed traces, METRICS pass reaction, brake stretch, and four lock ticks.",
  "catalogue": {
    "db": "DB-134",
    "ref": "SPX-1099",
    "catalogueTitle": "High-Speed Dash"
  },
  "destinations": ["OVERVIEW", "METRICS", "LOGS"],
