{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/capsule-deploy.schema.json",
  "title": "CapsuleDeploy",
  "description": "Portable contract for hardware capsule deploy: extract, unseal, four decode lines, two-stage panel expansion, healthy lock.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "colours",
    "geometry",
    "capsule",
    "animation",
    "metadataOrder",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "capsule-deploy" },
    "intent": {
      "type": "string",
      "const": "Mirror of capsule-collapse: stamped hardware capsule extracts from storage, unseals, decodes through four lines, and constructively rebuilds a healthy service panel."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "service", "trigger", "reset", "stored", "healthy", "finalStatus"],
      "properties": {
        "system": { "type": "string", "const": "STORAGE // 03" },
        "service": { "type": "string", "const": "API-07" },
        "trigger": { "type": "string", "const": "DEPLOY" },
        "reset": { "type": "string", "const": "RESET" },
        "stored": { "type": "string", "const": "Stored API-07. Status: stored." },
        "healthy": {
          "type": "string",
          "const": "Service API-07. Status: healthy. Region London. Latency 24ms. Workers 8."
        },
        "finalStatus": { "type": "string", "const": "Service API-07 deployed and healthy." },
        "railStored": { "type": "string", "const": "STORED" },
        "railVacant": { "type": "string", "const": "VACANT" }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper", "ink", "panel", "accent", "cap", "band", "seam", "stamp"],
      "properties": {
        "paper": { "type": "string", "const": "#e9e5db" },
        "ink": { "type": "string", "const": "#19242b" },
        "panel": { "type": "string", "const": "#f8f5ed" },
        "accent": { "type": "string", "const": "#5d8c87" },
        "cap": { "type": "string", "const": "#4a6f6b" },
        "band": { "type": "string", "const": "#6fa39d" },
        "seam": { "type": "string", "const": "#3d5c58" },
        "stamp": { "type": "string", "const": "#f2efe6" }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expanded", "expandStage1", "dockSlot", "capsuleShell", "decodeLines"],
      "properties": {
        "expanded": { "type": "array", "const": [280, 180] },
        "expandStage1": { "type": "array", "const": [100, 74] },
        "dockSlot": { "type": "array", "const": [54, 34] },
        "capsuleShell": { "type": "array", "const": [88, 36] },
        "decodeLines": {
          "type": "object",
          "const": { "count": 4, "horizontalPx": 80, "verticalPx": 60 }
        }
      }
    },
    "capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractTravelPx", "stampId", "lidOpenDeg"],
      "properties": {
        "extractTravelPx": { "type": "number", "const": 60 },
        "stampId": { "type": "string", "const": "API-07" },
        "lidOpenDeg": { "type": "number", "const": 88 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extractMs",
        "unsealMs",
        "decodeMs",
        "expand1Ms",
        "expand2Ms",
        "staggerMs",
        "lockMs",
        "loops"
      ],
      "properties": {
        "extractMs": { "type": "number", "const": 120 },
        "unsealMs": { "type": "number", "const": 120 },
        "decodeMs": { "type": "number", "const": 150 },
        "expand1Ms": { "type": "number", "const": 140 },
        "expand2Ms": { "type": "number", "const": 140 },
        "staggerMs": { "type": "number", "const": 45 },
        "lockMs": { "type": "number", "const": 120 },
        "loops": { "type": "boolean", "const": false }
      }
    },
    "metadataOrder": {
      "type": "array",
      "const": ["STATUS", "REGION", "LATENCY", "WORKERS"]
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["politeFinal", "cardLabel"],
      "properties": {
        "politeFinal": { "type": "boolean", "const": true },
        "cardLabel": { "type": "string", "const": "Service API-07" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateHealthy", "triggers"],
      "properties": {
        "immediateHealthy": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": [
            "prefers-reduced-motion: reduce",
            "data-force-reduced-motion=true"
          ]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "card", "shell", "stamp", "dock"],
      "properties": {
        "root": { "type": "string", "const": "cdp" },
        "card": { "type": "string", "const": "cdp__card" },
        "shell": { "type": "string", "const": "cdp__shell" },
        "stamp": { "type": "string", "const": "cdp__stamp" },
        "dock": { "type": "string", "const": "cdp__dock" }
      }
    }
  }
}
