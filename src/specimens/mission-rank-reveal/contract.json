{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/mission-rank-reveal.schema.json",
  "title": "MissionRankReveal",
  "description": "A generic rank card slams into the briefing panel, then a stamp impacts to confirm it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "rank", "cardMs", "stampMs", "colours", "reducedMotion"],
  "properties": {
    "name": { "type": "string", "const": "mission-rank-reveal" },
    "rank": { "type": "string", "const": "B" },
    "cardMs": { "type": "number", "const": 280 },
    "stampMs": { "type": "number", "const": 240 },
    "settleMs": { "type": "number", "const": 100 },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "parchment", "chakra", "alert", "olive", "off"],
      "properties": {
        "ink": { "type": "string", "const": "#101318" },
        "parchment": { "type": "string", "const": "#E7DDC7" },
        "chakra": { "type": "string", "const": "#3A9BD9" },
        "alert": { "type": "string", "const": "#D94A38" },
        "olive": { "type": "string", "const": "#69745A" },
        "off": { "type": "string", "const": "#F4F1E8" }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateConfirmed"],
      "properties": {
        "immediateConfirmed": { "type": "boolean", "const": true }
      }
    }
  }
}
