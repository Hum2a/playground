{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/navigation-drawer-edge-pull.schema.json",
  "title": "NavigationDrawerEdgePull",
  "description": "Portable contract for edge-initiated navigation drawer with scrim and pill selection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "intent", "layout", "gesture", "reducedMotion", "classNames"],
  "properties": {
    "name": { "type": "string", "const": "navigation-drawer-edge-pull" },
    "intent": {
      "type": "string",
      "const": "Left-edge drawer pull with pointer tracking, scrim, app shift, and five destinations."
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageWidthPx", "stageHeightPx", "drawerWidthPx", "edgeZonePx"],
      "properties": {
        "stageWidthPx": { "type": "number", "const": 390 },
        "stageHeightPx": { "type": "number", "const": 700 },
        "drawerWidthPx": { "type": "number", "const": 304 },
        "edgeZonePx": { "type": "number", "const": 24 }
      }
    },
    "gesture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openProgress", "velocityThresholdPxMs", "appShiftPx", "scrimMax"],
      "properties": {
        "openProgress": { "type": "number", "const": 0.46 },
        "velocityThresholdPxMs": { "type": "number", "const": 0.5 },
        "appShiftPx": { "type": "number", "const": 24 },
        "scrimMax": { "type": "number", "const": 0.32 }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directDrag", "snapInstant", "triggers"],
      "properties": {
        "directDrag": { "type": "boolean", "const": true },
        "snapInstant": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": ["prefers-reduced-motion: reduce", "data-force-reduced-motion=true"]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "stage", "drawer", "app", "pill"],
      "properties": {
        "root": { "type": "string", "const": "ndep" },
        "stage": { "type": "string", "const": "ndep__stage" },
        "drawer": { "type": "string", "const": "ndep__drawer" },
        "app": { "type": "string", "const": "ndep__app" },
        "pill": { "type": "string", "const": "ndep__pill" }
      }
    }
  }
}
