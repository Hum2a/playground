{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.humza-butt.space/contracts/midnight-clock-transition.schema.json",
  "title": "MidnightClockTransition",
  "description": "Portable contract for a temporal midnight threshold: accelerating clock hands, seam impact, centre-out panel wipe, date/state swap.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "intent",
    "copy",
    "colours",
    "clock",
    "animation",
    "a11y",
    "reducedMotion",
    "classNames"
  ],
  "properties": {
    "name": { "type": "string", "const": "midnight-clock-transition" },
    "intent": {
      "type": "string",
      "const": "Temporal transition where accelerating clock hands align at midnight, a vertical seam splits the host, and panels wipe into the next day."
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dateA",
        "titleA",
        "timeA",
        "dateB",
        "titleB",
        "timeB",
        "trigger",
        "reset",
        "statusEvening",
        "statusMidnight"
      ],
      "properties": {
        "dateA": { "type": "string", "const": "06 APR" },
        "titleA": { "type": "string", "const": "LATE EVENING" },
        "timeA": { "type": "string", "const": "23:54" },
        "dateB": { "type": "string", "const": "07 APR" },
        "titleB": { "type": "string", "const": "MIDNIGHT" },
        "timeB": { "type": "string", "const": "00:00" },
        "trigger": { "type": "string", "const": "ADVANCE TIME" },
        "reset": { "type": "string", "const": "RESET" },
        "statusEvening": {
          "type": "string",
          "const": "Late evening. 6 April, 23:54."
        },
        "statusMidnight": {
          "type": "string",
          "const": "Midnight. 7 April."
        }
      }
    },
    "colours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nearBlack", "deepBlue", "blue", "bright", "pale"],
      "properties": {
        "nearBlack": { "type": "string", "const": "#020912" },
        "deepBlue": { "type": "string", "const": "#071e38" },
        "blue": { "type": "string", "const": "#155f8e" },
        "bright": { "type": "string", "const": "#45b8df" },
        "pale": { "type": "string", "const": "#d7f6ff" }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diameterPx",
        "hourStartDeg",
        "minuteStartDeg",
        "hourEndDeg",
        "minuteTravelDeg",
        "markerCount"
      ],
      "properties": {
        "diameterPx": { "type": "number", "const": 150 },
        "hourStartDeg": { "type": "number", "const": 357 },
        "minuteStartDeg": { "type": "number", "const": 324 },
        "hourEndDeg": { "type": "number", "const": 360 },
        "minuteTravelDeg": { "type": "number", "const": 1008 },
        "markerCount": { "type": "number", "const": 12 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anticipateMs",
        "impactMs",
        "seamMs",
        "wipeMs",
        "swapMs",
        "revealMs",
        "totalMs",
        "digitalSteps",
        "loops"
      ],
      "properties": {
        "anticipateMs": { "type": "number", "const": 120 },
        "impactMs": { "type": "number", "const": 620 },
        "seamMs": { "type": "number", "const": 100 },
        "wipeMs": { "type": "number", "const": 180 },
        "swapMs": { "type": "number", "const": 700 },
        "revealMs": { "type": "number", "const": 800 },
        "totalMs": { "type": "number", "const": 900 },
        "digitalSteps": {
          "type": "array",
          "const": ["23:54", "23:56", "23:58", "23:59", "00:00"]
        },
        "loops": { "type": "boolean", "const": false }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["politeStatus", "clockDecorative", "noIntermediateAnnouncements"],
      "properties": {
        "politeStatus": { "type": "boolean", "const": true },
        "clockDecorative": { "type": "boolean", "const": true },
        "noIntermediateAnnouncements": { "type": "boolean", "const": true }
      }
    },
    "reducedMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateSwap", "triggers"],
      "properties": {
        "immediateSwap": { "type": "boolean", "const": true },
        "triggers": {
          "type": "array",
          "const": [
            "prefers-reduced-motion: reduce",
            "data-force-reduced-motion=true"
          ]
        }
      }
    },
    "classNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "face", "hour", "minute", "seam", "panel"],
      "properties": {
        "root": { "type": "string", "const": "midnight-clock" },
        "face": { "type": "string", "const": "midnight-clock__face" },
        "hour": { "type": "string", "const": "midnight-clock__hand--hour" },
        "minute": { "type": "string", "const": "midnight-clock__hand--minute" },
        "seam": { "type": "string", "const": "midnight-clock__seam" },
        "panel": { "type": "string", "const": "midnight-clock__panel" }
      }
    }
  }
}
